<a href="{{ url|default('#') }}"
   aria-label="Découvrir {{ name|default('cette catégorie') }}"
   class="group relative block aspect-[4/5] overflow-hidden rounded-2xl bg-ink shadow-md transition-all duration-500 hover:-translate-y-1 hover:shadow-xl">

    {# Image de la sous-catégorie #}
    {% if image is defined and image %}
        <img
            src="{{ image }}"
            alt="{{ name|default('Catégorie ModeBoutique') }}"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
        >
    {% else %}
        <div class="absolute inset-0 flex items-center justify-center bg-cream text-ink-soft">
            Image à venir
        </div>
    {% endif %}

    {# Dégradé pour la lisibilité du texte #}
    <div class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/35 to-transparent transition-opacity duration-500 group-hover:from-ink"></div>

    {# Badge #}
    <div class="absolute left-4 top-4 rounded-full border border-white/40 bg-white/90 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand backdrop-blur-sm">
        ModeBoutique
    </div>

    {# Informations de la catégorie #}
    <div class="absolute inset-x-0 bottom-0 p-5 text-white sm:p-6">

        <h3 class="font-serif text-2xl font-semibold leading-tight text-white drop-shadow-md transition-transform duration-300 group-hover:-translate-y-1 sm:text-3xl">
            {{ name|default('Catégorie') }}
        </h3>

        {% if description is defined and description %}
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-white/85 sm:text-base">
                {{ description }}
            </p>
        {% endif %}

        {# Indication visuelle #}
        <div class="mt-5 flex items-center justify-between border-t border-white/40 pt-4">
            <span class="text-sm font-semibold tracking-wide">
                Découvrir la collection
            </span>

            <span class="flex h-9 w-9 items-center justify-center rounded-full border border-white/70 transition-all duration-300 group-hover:border-white group-hover:bg-white group-hover:text-brand">
                <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </span>
        </div>

    </div>
</a>
