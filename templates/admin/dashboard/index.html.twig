{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Tableau de bord | ModeBoutique{% endblock %}

{% block admin_content %}

    {# Titre et statut #}
    <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[#9B7049]">
                Vue d'ensemble
            </p>

            <h1 class="text-3xl font-semibold tracking-tight text-[#292524] sm:text-4xl">
                Tableau de bord
            </h1>

            <p class="mt-3 max-w-2xl text-sm leading-6 text-stone-500 sm:text-base">
                Pilotez votre boutique, organisez votre catalogue et suivez votre activité.
            </p>
        </div>

        <span class="inline-flex w-fit items-center gap-2 rounded-full border border-[#E5D9CA] bg-white px-4 py-2.5 text-xs font-medium text-[#292524]">
            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            Environnement de développement
        </span>
    </div>

    {# Cartes statistiques #}
    <div class="mb-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        {% set stats = [
        {
            label: 'Produits',
            value: totalProducts,
            description: 'Articles du catalogue',
            icon: '◇'
        },
        {
            label: 'Commandes',
            value: totalOrders,
            description: 'Suivi des achats',
            icon: '▣'
        },
        {
            label: 'Clients',
            value: totalClients,
            description: 'Comptes clients',
            icon: '♙'
        },
        {
            label: 'Stock faible',
            value: lowStockCount,
            description: 'Articles à surveiller',
            icon: '△'
        }
    ] %}

        {% for stat in stats %}
            <article class="rounded-2xl border border-[#E8DED3] bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="text-sm font-medium text-stone-500">{{ stat.label }}</p>
                        <p class="mt-4 text-3xl font-semibold tracking-tight text-[#292524]">
                            {{ stat.value }}
                        </p>
                    </div>

                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-[#F2E4D5] text-2xl text-[#8C6038]">
                        {{ stat.icon }}
                    </span>
                </div>

                <p class="mt-3 text-xs text-stone-500">{{ stat.description }}</p>
            </article>
        {% endfor %}

    </div>

    {# Bannière de mode et modules #}
    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.65fr)_minmax(280px,0.8fr)]">

        <section class="overflow-hidden rounded-2xl border border-[#E8DED3] bg-white shadow-sm">

            <div class="grid md:grid-cols-[255px_minmax(0,1fr)]">

                {# Photo de mode #}
                <div class="relative min-h-[280px] overflow-hidden md:min-h-full">
                    <img
                        src="{{ asset('images/products/robe-fleurie-long.jpg') }}"
                        alt="Collection élégante ModeBoutique"
                        class="absolute inset-0 h-full w-full object-cover object-center"
                    >

                    <div class="absolute inset-0 bg-gradient-to-t from-[#292524]/45 via-transparent to-transparent"></div>

                    <span class="absolute bottom-5 left-5 rounded-full border border-white/60 bg-white/90 px-3 py-2 text-[10px] font-semibold uppercase tracking-wider text-[#725034] backdrop-blur">
                        Collection ModeBoutique
                    </span>
                </div>

                <div class="min-w-0 p-5 sm:p-7 lg:p-8">

                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#9B7049]">
                        Gestion de la boutique
                    </p>

                    <h2 class="mt-3 text-2xl font-semibold leading-tight tracking-tight text-[#292524] sm:text-3xl">
                        Les principaux modules
                    </h2>

                    <p class="mt-2 text-sm leading-6 text-stone-500">
                        Découvrez et gérez votre boutique en toute simplicité.
                    </p>

                    {% set modules = [
                        {
                            name: 'Produits',
                            description: 'Ajouter et modifier les articles.',
                            icon: '◇',
                            route: 'admin_products_index'
                        },
                        {
                            name: 'Catégories',
                            description: 'Organiser les collections femme et homme.',
                            icon: '▤',
                            route: 'admin_categories_index'
                        },
                        {
                            name: 'Stocks et variantes',
                            description: 'Gérer tailles, couleurs et pointures.',
                            icon: '▧',
                            route: 'admin_stock_index'
                        },
                        {
                            name: 'Commandes',
                            description: 'Consulter et traiter les commandes clients.',
                            icon: '▣',
                            route: 'admin_orders_index'
                        }
                    ] %}

                    <div class="mt-5 divide-y divide-[#EEE6DC]">
                        {% for module in modules %}
                            <a
                                href="{{ path(module.route) }}"
                                class="group flex items-center gap-3 rounded-xl py-4 transition hover:bg-[#FCFAF7] hover:px-3"
                            >
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#F2E4D5] text-xl text-[#8C6038] transition group-hover:bg-[#EAD5BF]">
                                    {{ module.icon }}
                                </span>

                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-semibold text-[#292524] transition group-hover:text-[#8C6038]">
                                        {{ module.name }}
                                    </p>

                                    <p class="mt-1 text-xs leading-5 text-stone-500">
                                        {{ module.description }}
                                    </p>
                                </div>

                                <span class="shrink-0 rounded-full bg-[#F2E8DE] px-2.5 py-1.5 text-[10px] font-medium text-[#725034]">
                                    Disponible
                                </span>

                                <span class="shrink-0 text-stone-400 transition group-hover:translate-x-1 group-hover:text-[#8C6038]">
                                    →
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>

        {# Colonne droite #}
        <div class="space-y-5">

            <section class="rounded-2xl border border-[#E8DED3] bg-white p-5 shadow-sm sm:p-6">
                <h2 class="text-xl font-semibold text-[#292524]">
                    Accès rapide
                </h2>

                <p class="mt-2 text-sm leading-6 text-stone-500">
                    Les outils disponibles pour le moment.
                </p>

                <a
                    href="{{ path('home') }}"
                    class="mt-5 flex items-center justify-between gap-4 rounded-xl border border-[#DCC4AC] p-4 transition hover:bg-[#F9F4EE]"
                >
                    <div>
                        <p class="text-sm font-semibold text-[#292524]">
                            Voir la boutique
                        </p>
                        <p class="mt-1 text-xs text-stone-500">
                            Consulter le site public.
                        </p>
                    </div>

                    <span class="text-xl text-[#9B7049]">↗</span>
                </a>

                <div class="mt-4 rounded-xl bg-[#F2E4D5] p-4">
                    <p class="text-sm font-semibold text-[#292524]">
                        Prochaine étape
                    </p>
                    <p class="mt-2 text-xs leading-6 text-stone-600">
                        Continuer à améliorer votre espace d’administration en suivant
                        les commandes, les clients et les niveaux de stock pour assurer
                        le bon fonctionnement de la boutique.
                    </p>
                </div>
            </section>

            <section class="rounded-2xl border border-[#E8DED3] bg-white p-5 shadow-sm sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-stone-500">
                    Compte connecté
                </p>

                <div class="mt-4 flex items-center gap-3">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#F2E4D5] text-lg font-semibold text-[#8C6038]">
                        A
                    </div>

                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-[#292524]">Administratrice</p>
                        <p class="mt-1 break-all text-xs text-stone-500">
                            {{ app.user.email }}
                        </p>
                    </div>
                </div>

                <span class="mt-4 inline-block rounded-full bg-[#F2E8DE] px-3 py-1.5 text-[10px] font-semibold text-[#725034]">
                    ROLE_ADMIN
                </span>
            </section>

        </div>
    </div>

{% endblock %}
