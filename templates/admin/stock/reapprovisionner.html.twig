{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Réapprovisionnement | ModeBoutique{% endblock %}

{% block admin_content %}

<div class="mx-auto max-w-2xl space-y-6">

    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
            Catalogue & inventaire
        </p>

        <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
            Réapprovisionner le stock
        </h1>

        <p class="mt-2 text-sm text-stone-500">
            Ajoutez de nouvelles unités à une variante existante.
        </p>
    </div>

    <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:p-8">

        <div class="mb-6 flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl font-semibold text-[#B08D67]">
                MB
            </div>

            <div>
                <h2 class="font-semibold text-stone-800">
                    {{ variant.product.name }}
                </h2>

                <p class="mt-1 text-sm text-stone-500">
                    {{ variant.color ?? 'Standard' }}
                    {% if variant.size %}
                        · {{ variant.size }}
                    {% endif %}
                </p>

                <p class="mt-1 text-xs text-stone-400">
                    Référence : {{ variant.sku }}
                </p>
            </div>
        </div>

        <div class="mb-6 grid grid-cols-2 gap-4">

            <div class="rounded-xl bg-stone-50 p-4">
                <p class="text-xs text-stone-500">Stock actuel</p>
                <p class="mt-2 text-2xl font-semibold text-stone-800">
                    {{ variant.stockQuantity }}
                </p>
            </div>

            <div class="rounded-xl bg-stone-50 p-4">
                <p class="text-xs text-stone-500">Seuil d'alerte</p>
                <p class="mt-2 text-2xl font-semibold text-stone-800">
                    {{ variant.lowStockThreshold }}
                </p>
            </div>

        </div>

        {% for message in app.flashes('error') %}
            <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" class="space-y-5">

            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('reapprovisionner' ~ variant.id) }}"
            >

            <div>
                <label for="quantity" class="mb-2 block text-sm font-medium text-stone-700">
                    Quantité à ajouter
                </label>

                <input
                    type="number"
                    id="quantity"
                    name="quantity"
                    min="1"
                    step="1"
                    required
                    class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-800 outline-none transition focus:border-[#B08D67] focus:ring-2 focus:ring-[#B08D67]/20"
                    placeholder="Exemple : 10"
                >

                <p class="mt-2 text-xs text-stone-400">
                    Cette quantité sera ajoutée au stock actuel.
                </p>
            </div>

            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                <a
                    href="{{ path('admin_stock_index') }}"
                    class="rounded-xl border border-stone-300 px-5 py-3 text-center text-sm font-medium text-stone-600 transition hover:bg-stone-50"
                >
                    Annuler
                </a>

                <button
                    type="submit"
                    class="rounded-xl bg-[#292524] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#44403C]"
                >
                    Réapprovisionner
                </button>

            </div>

        </form>

    </div>

</div>

{% endblock %}
