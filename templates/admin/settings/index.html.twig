{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Paramètres de la boutique | ModeBoutique{% endblock %}

{% block admin_content %}
<div class="space-y-8">

    {# En-tête #}
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
            Configuration
        </p>

        <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
            Paramètres de la boutique
        </h1>

        <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-500">
            Personnalisez les informations de ModeBoutique et gérez les réglages de vente et de livraison.
        </p>
    </div>

    {# Messages de confirmation et d'erreur #}
    {% for message in app.flashes('success') %}
        <div class="flex items-start gap-3 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">
            <span class="text-lg">✓</span>
            <p>{{ message }}</p>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
            <span class="text-lg">!</span>
            <p>{{ message }}</p>
        </div>
    {% endfor %}

    {# Formulaire #}
    <form
        method="POST"
        action="{{ path('admin_settings_index') }}"
        class="space-y-6"
    >
        <input
            type="hidden"
            name="_token"
            value="{{ csrf_token('save_store_settings') }}"
        >

        {# Informations générales #}
        <section class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
            <div class="border-b border-stone-100 px-5 py-5 sm:px-7">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">◇</span>
                    <div>
                        <h2 class="font-semibold text-stone-800">Informations générales</h2>
                        <p class="mt-1 text-sm text-stone-500">Nom et présentation de votre boutique.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-6 p-5 sm:grid-cols-2 sm:p-7">

                <div class="sm:col-span-2">
                    <label for="store-name" class="mb-2 block text-sm font-medium text-stone-700">
                        Nom de la boutique
                    </label>
                    <input
                        id="store-name"
                        name="store_name"
                        type="text"
                        required
                        maxlength="150"
                        value="{{ app.request.method == 'POST' ? app.request.request.get('store_name') : settings.name }}"
                        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >
                </div>

                <div class="sm:col-span-2">
                    <label for="store-description" class="mb-2 block text-sm font-medium text-stone-700">
                        Description
                    </label>
                    <textarea
                        id="store-description"
                        name="store_description"
                        rows="3"
                        class="w-full resize-y rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm leading-6 outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >{{ app.request.method == 'POST' ? app.request.request.get('store_description') : settings.description }}</textarea>
                </div>

                <div class="sm:col-span-2">
                    <label class="mb-2 block text-sm font-medium text-stone-700">
                        Identité visuelle
                    </label>

                    <div class="flex flex-col gap-4 rounded-xl border border-dashed border-stone-300 bg-stone-50 p-4 sm:flex-row sm:items-center">
                        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-stone-800 font-serif text-3xl text-[#D6B58A]">
                            M
                        </div>

                        <div class="min-w-0 flex-1">
                            <p class="font-medium text-stone-800">Logo ModeBoutique</p>
                            <p class="mt-1 text-xs leading-5 text-stone-500">
                                Le logo actuel est conservé. La gestion de son remplacement pourra être ajoutée séparément.
                            </p>
                        </div>

                        <span class="w-fit rounded-lg border border-stone-200 bg-white px-3 py-2 text-xs text-stone-500">
                            Logo actuel
                        </span>
                    </div>
                </div>

            </div>
        </section>

        {# Coordonnées #}
        <section class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
            <div class="border-b border-stone-100 px-5 py-5 sm:px-7">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">✉</span>
                    <div>
                        <h2 class="font-semibold text-stone-800">Coordonnées</h2>
                        <p class="mt-1 text-sm text-stone-500">Informations de contact de la boutique.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-6 p-5 sm:grid-cols-2 sm:p-7">

                <div>
                    <label for="store-email" class="mb-2 block text-sm font-medium text-stone-700">
                        Adresse e-mail
                    </label>
                    <input
                        id="store-email"
                        name="store_email"
                        type="email"
                        required
                        maxlength="180"
                        value="{{ app.request.method == 'POST' ? app.request.request.get('store_email') : settings.email }}"
                        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >
                </div>

                <div>
                    <label for="store-phone" class="mb-2 block text-sm font-medium text-stone-700">
                        Téléphone
                    </label>
                    <input
                        id="store-phone"
                        name="store_phone"
                        type="tel"
                        maxlength="30"
                        value="{{ app.request.method == 'POST' ? app.request.request.get('store_phone') : settings.phone }}"
                        placeholder="Ex. : +261 34 00 000 00"
                        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >
                </div>

                <div class="sm:col-span-2">
                    <label for="store-address" class="mb-2 block text-sm font-medium text-stone-700">
                        Adresse de la boutique
                    </label>
                    <textarea
                        id="store-address"
                        name="store_address"
                        rows="2"
                        class="w-full resize-y rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >{{ app.request.method == 'POST' ? app.request.request.get('store_address') : settings.address }}</textarea>
                </div>

            </div>
        </section>

        {# Paramètres de vente #}
        <section class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
            <div class="border-b border-stone-100 px-5 py-5 sm:px-7">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">▤</span>
                    <div>
                        <h2 class="font-semibold text-stone-800">Paramètres de vente</h2>
                        <p class="mt-1 text-sm text-stone-500">Réglages généraux appliqués à la boutique.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-6 p-5 sm:grid-cols-2 sm:p-7">

                <div>
                    <label for="store-currency" class="mb-2 block text-sm font-medium text-stone-700">
                        Devise
                    </label>
                    {% set selectedCurrency = app.request.method == 'POST' ? app.request.request.get('store_currency') : settings.currency %}
                    <select
                        id="store-currency"
                        name="store_currency"
                        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >
                        <option value="MGA" {{ selectedCurrency == 'MGA' ? 'selected' : '' }}>Ariary malgache (Ar)</option>
                        <option value="EUR" {{ selectedCurrency == 'EUR' ? 'selected' : '' }}>Euro (€)</option>
                        <option value="USD" {{ selectedCurrency == 'USD' ? 'selected' : '' }}>Dollar américain ($)</option>
                    </select>
                </div>

                <div>
                    <label for="delivery-delay" class="mb-2 block text-sm font-medium text-stone-700">
                        Délai estimé de livraison
                    </label>
                    <input
                        id="delivery-delay"
                        name="delivery_delay"
                        type="text"
                        maxlength="100"
                        value="{{ app.request.method == 'POST' ? app.request.request.get('delivery_delay') : settings.deliveryDelay }}"
                        placeholder="Ex. : 2 à 5 jours ouvrables"
                        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >
                </div>

            </div>
        </section>

        {# Livraison #}
        <section class="overflow-hidden rounded-2xl border border-stone-200 bg-white">
            <div class="border-b border-stone-100 px-5 py-5 sm:px-7">
                <div class="flex items-center gap-3">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">⇢</span>
                    <div>
                        <h2 class="font-semibold text-stone-800">Livraison</h2>
                        <p class="mt-1 text-sm text-stone-500">Gérez les frais et le seuil de livraison gratuite.</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-6 p-5 sm:grid-cols-2 sm:p-7">

                <div>
                    <label for="shipping-fee" class="mb-2 block text-sm font-medium text-stone-700">
                        Frais de livraison standard (Ar)
                    </label>
                    <input
                        id="shipping-fee"
                        name="shipping_fee"
                        type="number"
                        min="0"
                        step="1"
                        value="{{ app.request.method == 'POST' ? app.request.request.get('shipping_fee') : settings.shippingFee }}"
                        placeholder="Ex. : 10000"
                        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >
                </div>

                <div>
                    <label for="free-shipping-threshold" class="mb-2 block text-sm font-medium text-stone-700">
                        Montant minimum pour livraison gratuite (Ar)
                    </label>
                    <input
                        id="free-shipping-threshold"
                        name="free_shipping_threshold"
                        type="number"
                        min="0"
                        step="1"
                        value="{{ app.request.method == 'POST' ? app.request.request.get('free_shipping_threshold') : settings.freeShippingThreshold }}"
                        placeholder="Ex. : 200000"
                        class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                    >
                </div>

            </div>
        </section>

        {# Actions #}
        <div class="flex flex-col gap-3 rounded-2xl border border-stone-200 bg-white p-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
            <p class="max-w-xl text-xs leading-5 text-stone-500">
                Les modifications seront enregistrées dans la base de données de ModeBoutique.
            </p>

            <div class="flex flex-col-reverse gap-3 sm:flex-row">
                <a href="{{ path('admin_dashboard') }}"
                   class="rounded-xl border border-stone-200 px-5 py-3 text-center text-sm font-medium text-stone-600 transition hover:bg-stone-50">
                    Retour au tableau de bord
                </a>

                <button
                    type="submit"
                    class="rounded-xl bg-[#292524] px-6 py-3 text-sm font-medium text-white transition hover:bg-[#B08D67]"
                >
                    Enregistrer les paramètres
                </button>
            </div>
        </div>

    </form>

</div>
{% endblock %}
