{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Gestion des clients | ModeBoutique{% endblock %}

{% block admin_content %}

    <div class="space-y-8">

        {# En-tête #}
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
                Relation client
            </p>

            <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
                Gestion des clients
            </h1>

            <p class="mt-2 text-sm text-stone-500">
                Consultez les comptes et suivez l'activité de vos clients.
            </p>
        </div>

        {# Statistiques #}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">

            {# Total des clients #}
            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Total clients</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">
                        ♙
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-stone-800">
                    {{ stats.total }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Comptes enregistrés
                </p>
            </div>

            {# Clients actifs #}
            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Clients actifs</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600">
                        ✓
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-emerald-700">
                    {{ stats.active }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Comptes actifs
                </p>
            </div>

            {# Clients inactifs #}
            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Clients inactifs</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600">
                        ◷
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-amber-700">
                    {{ stats.inactive }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Comptes inactifs
                </p>
            </div>

            {# Nouveaux clients #}
            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Nouveaux clients</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl text-blue-600">
                        +
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-blue-700">
                    {{ stats['new'] }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Inscrits durant les 30 derniers jours
                </p>
            </div>

            {# Commandes associées #}
            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Commandes associées</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">
                        ▤
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-stone-800">
                    {{ stats.orders }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Total des commandes clients
                </p>
            </div>

        </div>

        {# Liste des clients #}
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white">

            <div class="flex flex-col gap-2 border-b border-stone-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">

                <div>
                    <h2 class="font-semibold text-stone-800">
                        Tous les clients
                    </h2>

                    <p class="mt-1 text-sm text-stone-500">
                        Retrouvez les informations principales des comptes clients.
                    </p>
                </div>

                <span class="w-fit rounded-full bg-[#F5F0E8] px-3 py-1.5 text-xs font-medium text-[#8A6848]">
                    {{ stats.total }} clients
                </span>

            </div>

            <div class="overflow-x-auto">

                <table class="w-full min-w-[800px] text-left text-sm">

                    <thead class="bg-stone-50 text-xs uppercase tracking-wider text-stone-500">
                        <tr>
                            <th class="px-6 py-4 font-medium">Client</th>
                            <th class="px-6 py-4 font-medium">Inscription</th>
                            <th class="px-6 py-4 font-medium">Commandes</th>
                            <th class="px-6 py-4 font-medium">Statut du compte</th>
                            <th class="px-6 py-4 font-medium">Action</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-stone-100">

                        {% for customer in customers %}

                            <tr class="transition hover:bg-[#F5F0E8]/40">

                                {# Informations du client #}
                                <td class="px-6 py-5">
                                    <div class="flex items-center gap-3">

                                        {# Photo de profil #}
                                        <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[#F5F0E8] text-sm font-semibold text-[#8A6848]">

                                            {% if customer.profilePicture %}
                                                <img
                                                    src="{{ asset('uploads/profile/' ~ customer.profilePicture) }}"
                                                    alt="Photo de {{ customer.name }}"
                                                    class="h-full w-full object-cover"
                                                >
                                            {% else %}
                                                {{ customer.initials|default('CL') }}
                                            {% endif %}

                                        </div>

                                        <div class="min-w-0">
                                            <p class="font-semibold text-stone-800">
                                                {{ customer.name }}
                                            </p>

                                            <p class="mt-1 text-xs text-stone-500">
                                                {{ customer.email }}
                                            </p>
                                        </div>

                                    </div>
                                </td>

                                {# Date d'inscription #}
                                <td class="whitespace-nowrap px-6 py-5 text-stone-500">
                                    {{ customer.registeredAt }}
                                </td>

                                {# Nombre de commandes #}
                                <td class="px-6 py-5">
                                    <span class="inline-flex min-w-9 items-center justify-center rounded-lg bg-[#F5F0E8] px-3 py-1.5 text-xs font-semibold text-stone-700">
                                        {{ customer.orders }}
                                    </span>
                                </td>

                                {# Statut du compte #}
                                <td class="px-6 py-5">

                                    {% if customer.status == 'Actif' %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                                            Actif
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700">
                                            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                            Inactif
                                        </span>
                                    {% endif %}

                                </td>

                                {# Action sur le compte client #}
                                <td class="px-6 py-5">
                                    <form
                                        method="post"
                                        action="{{ path('admin_customers_toggle_status', {id: customer.id}) }}"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('toggle-status-' ~ customer.id) }}"
                                        >

                                        {% if customer.status == 'Actif' %}
                                            <button
                                                type="submit"
                                                class="rounded-lg bg-red-50 px-3 py-2 text-xs font-medium text-red-700 transition hover:bg-red-100"
                                            >
                                                Désactiver
                                            </button>
                                        {% else %}
                                            <button
                                                type="submit"
                                                class="rounded-lg bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700 transition hover:bg-emerald-100"
                                            >
                                                Réactiver
                                            </button>
                                        {% endif %}
                                    </form>
                                </td>

                            </tr>

                        {% else %}

                            {# Aucun client #}
                            <tr>
                                <td colspan="5" class="px-6 py-14 text-center">

                                    <div class="text-4xl text-[#B08D67]">
                                        ♙
                                    </div>

                                    <p class="mt-4 font-medium text-stone-700">
                                        Aucun client pour le moment
                                    </p>

                                    <p class="mt-2 text-sm text-stone-500">
                                        Les comptes clients apparaîtront ici après leur inscription.
                                    </p>

                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </div>

    </div>

{% endblock %}
