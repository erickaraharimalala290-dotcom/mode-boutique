{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Modifier mon profil | ModeBoutique{% endblock %}

{% block admin_content %}

<div class="mx-auto max-w-4xl space-y-6">

    {# En-tête de la page #}
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#9B7049]">
            Paramètres du compte
        </p>

        <h1 class="mt-2 text-2xl font-bold text-[#292524] sm:text-3xl">
            Modifier mes informations
        </h1>

        <p class="mt-2 text-sm leading-6 text-stone-500">
            Gérez votre photo de profil et vos informations personnelles.
        </p>
    </div>

    {# Messages de notification #}
    {% for message in app.flashes('success') %}
        <div class="rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800" role="status">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
            {{ message }}
        </div>
    {% endfor %}

    {# Formulaire de modification #}
    <section class="rounded-2xl border border-[#E5D9CA] bg-white p-5 shadow-sm sm:p-8">

        <form
            method="post"
            enctype="multipart/form-data"
            action="{{ path('admin_profile_edit') }}"
            class="space-y-6"
        >

            {# Photo de profil #}
            <div class="flex flex-col gap-5 border-b border-[#E5D9CA] pb-6 sm:flex-row sm:items-center">

                <div class="flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden rounded-full border-4 border-[#F5F0E8] bg-[#F5F0E8] font-semibold text-[#8C694A]">
                    {% if user.profilePicture %}
                        <img
                            src="{{ asset('uploads/profile/' ~ user.profilePicture) }}"
                            alt="Photo de profil"
                            class="h-full w-full object-cover"
                        >
                    {% else %}
                        <span class="text-2xl">
                            {{ user.firstname|default('U')|first|upper }}{{ user.lastname|default('')|first|upper }}
                        </span>
                    {% endif %}
                </div>

                <div class="min-w-0">
                    <h2 class="font-semibold text-[#292524]">
                        Photo de profil
                    </h2>

                    <p class="mt-1 text-sm text-stone-500">
                        Choisissez une photo au format JPG, PNG ou WebP.
                    </p>

                    <input
                        type="file"
                        name="profilePicture"
                        accept="image/png,image/jpeg,image/webp"
                        class="mt-3 block w-full max-w-xs text-sm text-stone-500"
                    >

                    <p class="mt-2 text-xs text-stone-500">
                        Taille maximale : 5 Mo.
                    </p>
                </div>
            </div>

            {# Prénom #}
            <div>
                <label for="firstName" class="mb-2 block text-sm font-semibold text-[#292524]">
                    Prénom
                </label>

                <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    value="{{ user.firstname }}"
                    required
                    minlength="2"
                    maxlength="100"
                    class="w-full rounded-xl border border-[#E5D9CA] bg-white px-4 py-3 text-[#292524] outline-none transition focus:border-[#B08D67] focus:ring-2 focus:ring-[#B08D67]/20"
                >
            </div>

            {# Nom #}
            <div>
                <label for="lastName" class="mb-2 block text-sm font-semibold text-[#292524]">
                    Nom
                </label>

                <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    value="{{ user.lastname }}"
                    required
                    minlength="2"
                    maxlength="100"
                    class="w-full rounded-xl border border-[#E5D9CA] bg-white px-4 py-3 text-[#292524] outline-none transition focus:border-[#B08D67] focus:ring-2 focus:ring-[#B08D67]/20"
                >
            </div>

            {# Adresse e-mail #}
            <div>
                <label for="email" class="mb-2 block text-sm font-semibold text-[#292524]">
                    Adresse e-mail
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    value="{{ user.email }}"
                    required
                    maxlength="180"
                    autocomplete="email"
                    class="w-full rounded-xl border border-[#E5D9CA] bg-white px-4 py-3 text-[#292524] outline-none transition focus:border-[#B08D67] focus:ring-2 focus:ring-[#B08D67]/20"
                >
            </div>

            {# Actions #}
            <div class="flex flex-wrap justify-end gap-3 border-t border-[#E5D9CA] pt-6">

                <a
                    href="{{ path('admin_dashboard') }}"
                    class="rounded-full border border-[#E5D9CA] px-5 py-3 text-sm font-semibold text-stone-600 transition hover:bg-[#F5F0E8]"
                >
                    Annuler
                </a>

                <button
                    type="submit"
                    class="rounded-full bg-[#B08D67] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#96734F]"
                >
                    Enregistrer les modifications
                </button>

            </div>

        </form>
    </section>

</div>

{% endblock %}
