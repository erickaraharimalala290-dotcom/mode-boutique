{% extends 'layouts/admin-layout.html.twig' %}

{% set editing = is_edit|default(false) %}

{% block title %}
    {{ editing ? 'Modifier un produit' : 'Ajouter un produit' }} | Administration
{% endblock %}

{% block admin_content %}
    <div class="mx-auto max-w-5xl space-y-6">

        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold text-[#292524]">
                    {{ editing ? 'Modifier le produit' : 'Ajouter un produit' }}
                </h1>
                <p class="mt-1 text-sm text-[#78716C]">
                    Gérez les informations, les images et les variantes de votre produit.
                </p>
            </div>

            <a
                href="{{ path('admin_products_index') }}"
                class="rounded-lg border border-[#D6C7B5] px-4 py-2 text-sm font-medium text-[#57534E] hover:bg-[#F5F0E8]"
            >
                ← Retour à la liste
            </a>
        </div>

        {% for message in app.flashes('error') %}
            <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(form, {
            attr: {
                class: 'space-y-6',
                enctype: 'multipart/form-data',
                id: 'product-form',
                'data-turbo': 'false'
            }
        }) }}

        <div class="text-sm text-red-600">
            {{ form_errors(form) }}
        </div>

        {# Informations générales #}
        <div class="rounded-2xl border border-[#E7DED2] bg-white p-6 shadow-sm">
            <h2 class="mb-5 text-lg font-semibold text-[#292524]">Informations générales</h2>

            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    {{ form_label(form.name, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] px-3 py-2.5 focus:border-[#B08D67] focus:outline-none'}}) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.name) }}
                    </div>
                    
                </div>

                <div>
                    {{ form_label(form.slug, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.slug, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] px-3 py-2.5 focus:border-[#B08D67] focus:outline-none'}}) }}
                    {{ form_help(form.slug) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.slug) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.brand, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.brand, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] px-3 py-2.5 focus:border-[#B08D67] focus:outline-none'}}) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.brand) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.category, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.category, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] bg-white px-3 py-2.5 focus:border-[#B08D67] focus:outline-none'}}) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.category) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.price, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.price, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] px-3 py-2.5 focus:border-[#B08D67] focus:outline-none'}}) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.price) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.oldPrice, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.oldPrice, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] px-3 py-2.5 focus:border-[#B08D67] focus:outline-none'}}) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.oldPrice) }}
                    </div>
                </div>
            </div>

            <div class="mt-5">
                {{ form_label(form.description, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] px-3 py-2.5 focus:border-[#B08D67] focus:outline-none'}}) }}
                <div class="mt-1 text-sm text-red-600">
                    {{ form_errors(form.description) }}
                </div>
            </div>
        </div>

        {# Image principale #}
        <div class="rounded-2xl border border-[#E7DED2] bg-white p-6 shadow-sm">
            <h2 class="mb-2 text-lg font-semibold text-[#292524]">Image principale</h2>
            <p class="mb-4 text-sm text-[#78716C]">
                Cette image sera affichée en premier sur la fiche du produit.
            </p>

            {% if editing and product.mainImage %}
                {% set mainImagePath = product.mainImage starts with 'uploads/'
                    ? asset(product.mainImage)
                    : asset('images/products/' ~ product.mainImage)
                %}

                <div class="mb-4">
                    <img
                        src="{{ mainImagePath }}"
                        alt="{{ product.name }}"
                        class="h-40 w-40 rounded-xl border border-[#E7DED2] object-cover"
                    >
                    <p class="mt-2 text-xs text-[#78716C]">Image principale actuelle</p>
                </div>
            {% endif %}

            {{ form_widget(form.imageFile, {'attr': {'class': 'block w-full rounded-lg border border-[#D6C7B5] p-3 text-sm'}}) }}
            
            <div class="mt-1 text-sm text-red-600">
                {{ form_errors(form.imageFile) }}
            </div>
        </div>

        {# Galerie d'images #}
        <div class="rounded-2xl border border-[#E7DED2] bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-[#292524]">Images supplémentaires</h2>
            <p class="mt-1 text-sm text-[#78716C]">
                Sélectionnez plusieurs images et associez une couleur à chacune.
            </p>

            <div class="mt-5">
                {{ form_label(form.imagesFiles, 'Choisir les images', {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}

                {{ form_widget(form.imagesFiles, {
                    attr: {
                        id: 'product_imagesFiles',
                        class: 'block w-full rounded-lg border border-[#D6C7B5] p-3 text-sm'
                    }
                }) }}

                <div class="mt-1 text-sm text-red-600">
                    {{ form_errors(form.imagesFiles) }}
                </div>
            </div>

            {{ form_widget(form.imagesColors, {
                attr: {
                    id: 'product_imagesColors',
                    class: 'hidden'
                }
            }) }}

            <div id="selected-images-list" class="mt-5 space-y-3"></div>
        </div>

        {# Variantes et stock #}
        <div class="rounded-2xl border border-[#E7DED2] bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h2 class="text-lg font-semibold text-[#292524]">Variantes et stock</h2>
                    <p class="mt-1 text-sm text-[#78716C]">
                        Ajoutez les combinaisons de couleurs et de tailles disponibles.
                    </p>
                </div>

                <button
                    type="button"
                    id="add-variant-button"
                    class="rounded-lg bg-[#B08D67] px-4 py-2 text-sm font-semibold text-white hover:bg-[#96724F]"
                >
                    + Ajouter une variante
                </button>
            </div>

            {{ form_widget(form.variantsData, {
                attr: {
                    id: 'product_variantsData',
                    class: 'hidden'
                }
            }) }}

            <div id="variants-list" class="mt-5 space-y-3"></div>

            <p class="mt-4 text-xs text-[#78716C]">
                Exemple : Noir / M / 10 pièces, Beige / S / 5 pièces.
                Les variantes retirées seront désactivées afin de préserver l'historique.
            </p>
        </div>

        {# Publication #}
        <div class="rounded-2xl border border-[#E7DED2] bg-white p-6 shadow-sm">
            <h2 class="mb-5 text-lg font-semibold text-[#292524]">Publication</h2>

            <div class="grid gap-5 md:grid-cols-2">
                <div>
                    {{ form_label(form.isActive, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.isActive, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] bg-white px-3 py-2.5'}}) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.isActive) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.isFeatured, null, {'label_attr': {'class': 'mb-2 block text-sm font-medium text-[#44403C]'}}) }}
                    {{ form_widget(form.isFeatured, {'attr': {'class': 'w-full rounded-lg border border-[#D6C7B5] bg-white px-3 py-2.5'}}) }}
                    <div class="mt-1 text-sm text-red-600">
                        {{ form_errors(form.isFeatured) }}
                    </div>
                </div>
            </div>
        </div>

        {# Boutons d'action #}
        <div class="flex flex-wrap justify-end gap-3">
            <a
                href="{{ path('admin_products_index') }}"
                class="rounded-lg border border-[#D6C7B5] px-5 py-2.5 text-sm font-medium text-[#57534E] hover:bg-[#F5F0E8]"
            >
                Annuler
            </a>

            <button
                type="submit"
                class="rounded-lg bg-[#292524] px-6 py-2.5 text-sm font-semibold text-white hover:bg-[#44403C]"
            >
                Ajouter le produit
            </button>
        </div>

        {{ form_end(form) }}

        {# Images déjà enregistrées : formulaires indépendants du formulaire principal. #}
        {% if editing and product.images|length > 0 %}
            <div class="rounded-2xl border border-[#E7DED2] bg-white p-6 shadow-sm">
                <h2 class="mb-4 text-lg font-semibold text-[#292524]">
                    Images déjà enregistrées
                </h2>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for image in product.images %}
                        {% set galleryImagePath = image.imagePath starts with 'uploads/'
                            ? asset(image.imagePath)
                            : asset('images/products/' ~ image.imagePath)
                        %}

                        <div class="rounded-xl border border-[#E7DED2] p-3">
                            <img
                                src="{{ galleryImagePath }}"
                                alt="{{ image.altText|default(product.name) }}"
                                class="h-36 w-full rounded-lg object-cover"
                            >

                            <div class="mt-3 flex items-center justify-between gap-2">
                                <span class="text-sm font-medium text-[#44403C]">
                                    {{ image.color|default('Couleur non définie') }}
                                </span>

                                {% if image.id %}
                                    <form
                                        method="post"
                                        action="{{ path('admin_products_image_delete', {
                                            'id': product.id,
                                            'imageId': image.id
                                        }) }}"
                                        onsubmit="return confirm('Voulez-vous vraiment supprimer cette image ?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete-product-image-' ~ image.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="rounded-lg bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100"
                                        >
                                            Supprimer
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </div>

    <script src="{{ asset('js/admin/product-images.js') }}" defer></script>
    <script src="{{ asset('js/admin/product-variants.js') }}" defer></script>
{% endblock %}
