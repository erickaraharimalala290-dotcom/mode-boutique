{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Messages clients | ModeBoutique{% endblock %}

{% block admin_content %}
    <div class="space-y-8">

        {# En-tête #}
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
                Relation client
            </p>

            <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
                Messages clients
            </h1>

            <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-500">
                Consultez les demandes et échangez directement avec vos clients.
            </p>
        </div>

        {# Notifications #}
        {% for message in app.flashes('success') %}
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
                {{ message }}
            </div>
        {% endfor %}

        {# Statistiques #}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Total messages</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">
                        ✉
                    </span>
                </div>
                <p class="mt-4 text-3xl font-semibold text-stone-800">{{ stats.total }}</p>
                <p class="mt-2 text-xs text-stone-400">Messages reçus</p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Non lus</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600">
                        !
                    </span>
                </div>
                <p
                    data-unread-messages-stat
                    class="mt-4 text-3xl font-semibold text-amber-600"
                >
                    {{ stats.unread }}
                </p>
                <p class="mt-2 text-xs text-stone-400">Demandes à consulter</p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Déjà lus</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600">
                        ✓
                    </span>
                </div>
                <p
                    data-read-messages-stat
                    class="mt-4 text-3xl font-semibold text-emerald-700"
                >
                    {{ stats.read }}
                </p>
                <p class="mt-2 text-xs text-stone-400">Messages consultés</p>
            </div>

        </div>

        {# Information #}
        <div class="flex items-start gap-4 rounded-2xl border border-[#B08D67]/20 bg-[#F5F0E8] p-5">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-xl text-[#B08D67]">
                ✉
            </div>
            <div>
                <h2 class="font-semibold text-stone-800">
                    Restez à l'écoute de vos clients
                </h2>
                <p class="mt-1 text-sm leading-6 text-stone-600">
                    Consultez les messages reçus et répondez directement depuis votre espace d'administration.
                </p>
            </div>
        </div>

        {# Liste des messages #}
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white">

            <div class="border-b border-stone-100 px-5 py-5 sm:px-6">
                <h2 class="font-semibold text-stone-800">
                    Boîte de réception
                </h2>
                <p class="mt-1 text-sm text-stone-500">
                    Ouvrez un message pour consulter la conversation.
                </p>
            </div>

            <div class="divide-y divide-stone-100">

                {% for message in messages %}

                    <details
                        class="group px-5 py-5 transition hover:bg-[#FCFAF7] sm:px-6"
                        data-message-details
                        data-message-was-read="{{ message.isRead ? '1' : '0' }}"
                    >

                        {# En-tête du message #}
                        <summary class="flex cursor-pointer list-none flex-col gap-4 sm:flex-row sm:items-center sm:justify-between [&::-webkit-details-marker]:hidden">

                            <div class="flex min-w-0 items-start gap-3">

                                <div class="h-11 w-11 shrink-0 overflow-hidden rounded-full bg-[#F5F0E8]">

                                    {% if message.profilePicture %}
                                        <img
                                            src="{{ asset('uploads/profile/' ~ message.profilePicture) }}"
                                            alt="Photo de profil de {{ message.name }}"
                                            class="h-full w-full object-cover"
                                        >
                                    {% else %}
                                        <div class="flex h-full w-full items-center justify-center text-sm font-semibold text-[#8A6848]">
                                            {{ message.name|split(' ')|map(part => part|first)|join|upper }}
                                        </div>
                                    {% endif %}

                                </div>

                                <div class="min-w-0">

                                    <div class="flex flex-wrap items-center gap-2">
                                        <p class="font-semibold text-stone-800">
                                            {{ message.name }}
                                        </p>

                                        {% if message.isRead %}
                                            <span
                                                data-message-read-label
                                                class="rounded-full bg-stone-100 px-2.5 py-1 text-[10px] font-medium text-stone-500"
                                            >
                                                Lu
                                            </span>
                                        {% else %}
                                            <span
                                                data-message-read-label
                                                class="rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-semibold text-amber-700"
                                            >
                                                Non lu
                                            </span>
                                        {% endif %}

                                        {% if message.replies|length > 0 %}
                                            <span class="rounded-full bg-[#F5F0E8] px-2.5 py-1 text-[10px] font-semibold text-[#8A6848]">
                                                {{ message.replies|length }} réponse(s)
                                            </span>
                                        {% endif %}
                                    </div>

                                    <p class="mt-1 truncate text-xs text-stone-500">
                                        {{ message.email }}
                                    </p>

                                    <p class="mt-2 text-sm font-medium text-stone-700">
                                        {{ message.subject }}
                                    </p>

                                    <p class="mt-1 text-sm leading-5 text-stone-500">
                                        {{ message.message|length > 100
                                            ? message.message|slice(0, 100) ~ '…'
                                            : message.message }}
                                    </p>

                                </div>
                            </div>

                            <div class="flex shrink-0 items-center justify-between gap-4 sm:flex-col sm:items-end sm:justify-center">
                                <span class="text-xs text-stone-400">
                                    {{ message.date }}
                                </span>

                                <span class="text-sm font-medium text-[#8A6848] group-open:hidden">
                                    Lire la conversation ↓
                                </span>

                                <span class="hidden text-sm font-medium text-[#8A6848] group-open:inline">
                                    Fermer ↑
                                </span>
                            </div>

                        </summary>

                        {# Formulaire caché pour marquer automatiquement le message comme lu. #}
                        <form
                            method="post"
                            action="{{ path('admin_messages_mark_read', {id: message.id}) }}"
                            data-auto-mark-read
                            hidden
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('mark_read_' ~ message.id) }}"
                            >
                        </form>

                        {# Contenu détaillé #}
                        <div class="ml-0 mt-5 rounded-xl border border-stone-100 bg-[#FCFAF7] p-4 sm:ml-14 sm:p-5">

                            {# Message original #}
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">
                                    Message initial du client
                                </p>

                                <p class="mt-3 whitespace-pre-line text-sm leading-7 text-stone-700">
                                    {{ message.message }}
                                </p>

                                <div class="mt-4 border-t border-stone-200 pt-3">
                                    <p class="text-xs text-stone-400">
                                        Envoyé par
                                    </p>
                                    <p class="mt-1 text-sm font-medium text-stone-700">
                                        {{ message.name }} · {{ message.email }}
                                    </p>
                                </div>
                            </div>

                            {# Historique des réponses #}
                            <div class="mt-6 border-t border-stone-200 pt-5">

                                <h3 class="font-semibold text-stone-800">
                                    Historique de la conversation
                                </h3>

                                <div class="mt-4 space-y-4">

                                    {% for reply in message.replies %}

                                        {% set isAdminReply = 'ROLE_ADMIN' in reply.sender.roles %}

                                        <div class="flex {{ isAdminReply ? 'justify-end' : 'justify-start' }}">

                                            <div
                                                class="w-full max-w-xl rounded-2xl border p-4
                                                {{ isAdminReply
                                                    ? 'border-[#B08D67]/30 bg-[#F5F0E8]'
                                                    : 'border-stone-200 bg-white' }}"
                                            >

                                                <div class="flex flex-wrap items-center justify-between gap-2">

                                                    <span class="text-xs font-semibold {{ isAdminReply ? 'text-[#8A6848]' : 'text-stone-600' }}">
                                                        {{ isAdminReply
                                                            ? 'Administration'
                                                            : 'Client · ' ~ reply.sender.email }}
                                                    </span>

                                                    <span class="text-[11px] text-stone-400">
                                                        {{ reply.createdAt|date('d/m/Y à H:i', 'Indian/Antananarivo') }}
                                                    </span>

                                                </div>

                                                <p class="mt-3 whitespace-pre-line text-sm leading-6 text-stone-700">
                                                    {{ reply.content }}
                                                </p>

                                            </div>

                                        </div>

                                    {% else %}

                                        <div class="rounded-xl border border-dashed border-stone-200 bg-white px-4 py-6 text-center">
                                            <p class="text-sm text-stone-500">
                                                Aucune réponse pour le moment.
                                            </p>
                                        </div>

                                    {% endfor %}

                                </div>
                            </div>

                            {# Formulaire de réponse administrateur #}
                            <div class="mt-6 border-t border-stone-200 pt-5">

                                <h3 class="font-semibold text-stone-800">
                                    Répondre au client
                                </h3>

                                <p class="mt-1 text-xs leading-5 text-stone-500">
                                    Votre réponse sera enregistrée dans la conversation du client.
                                </p>

                                <form
                                    method="post"
                                    action="{{ path('admin_messages_reply', {id: message.id}) }}"
                                    class="mt-4 space-y-3"
                                >

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('reply_' ~ message.id) }}"
                                    >

                                    <textarea
                                        name="content"
                                        rows="4"
                                        required
                                        maxlength="5000"
                                        placeholder="Écrivez votre réponse ici..."
                                        class="w-full resize-y rounded-xl border border-stone-200 bg-white px-4 py-3 text-sm text-stone-700 outline-none transition placeholder:text-stone-400 focus:border-[#B08D67] focus:ring-2 focus:ring-[#B08D67]/20"
                                    ></textarea>

                                    <div class="flex justify-end">
                                        <button
                                            type="submit"
                                            class="inline-flex items-center gap-2 rounded-xl bg-stone-800 px-5 py-3 text-sm font-medium text-white transition hover:bg-[#8A6848]"
                                        >
                                            Envoyer la réponse
                                            <span>→</span>
                                        </button>
                                    </div>

                                </form>

                            </div>

                            {# Changement du statut #}
                            <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-stone-200 pt-4">

                                <div>
                                    <p class="text-xs text-stone-400">
                                        Statut actuel
                                    </p>

                                    {% if message.isRead %}
                                        <span
                                            data-message-read-label
                                            class="mt-2 inline-flex rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-600"
                                        >
                                            Lu
                                        </span>
                                    {% else %}
                                        <span
                                            data-message-read-label
                                            class="mt-2 inline-flex rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700"
                                        >
                                            Non lu
                                        </span>
                                    {% endif %}
                                </div>

                                <div class="flex flex-wrap items-center gap-2">

                                    {# Bouton pour supprimer le message et ses réponses. #}
                                    <form
                                        method="post"
                                        action="{{ path('admin_messages_delete', {id: message.id}) }}"
                                        onsubmit="return confirm('Voulez-vous vraiment supprimer ce message et ses réponses ?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('delete_' ~ message.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="inline-flex items-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2.5 text-sm font-medium text-red-700 transition hover:bg-red-50"
                                        >
                                            Supprimer
                                        </button>
                                    </form>

                                    {# Bouton pour changer manuellement le statut du message. #}
                                    <form
                                        method="post"
                                        action="{{ path('admin_messages_toggle_read', {id: message.id}) }}"
                                    >

                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('toggle_read_' ~ message.id) }}"
                                        >

                                        <button
                                            type="submit"
                                            data-read-toggle-button
                                            class="inline-flex items-center gap-2 rounded-xl px-4 py-2.5 text-sm font-medium transition
                                            {{ message.isRead
                                                ? 'border border-amber-200 bg-white text-amber-700 hover:bg-amber-50'
                                                : 'bg-emerald-700 text-white hover:bg-emerald-800' }}"
                                        >
                                            {% if message.isRead %}
                                                Marquer comme non lu
                                            {% else %}
                                                Marquer comme lu
                                            {% endif %}
                                        </button>
                                    </form>

                                </div>

                            </div>

                        </div>

                    </details>

                {% else %}

                    <div class="px-6 py-12 text-center">
                        <p class="font-medium text-stone-700">
                            Aucun message
                        </p>
                        <p class="mt-2 text-sm text-stone-500">
                            Les messages reçus apparaîtront ici.
                        </p>
                    </div>

                {% endfor %}

            </div>

        </div>

    </div>
{% endblock %}
