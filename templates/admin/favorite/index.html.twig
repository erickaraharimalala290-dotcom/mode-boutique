{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Favoris clients | ModeBoutique{% endblock %}

{% block admin_content %}
<div class="space-y-8">

    {# En-tête #}
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
            Relation client
        </p>

        <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
            Favoris clients
        </h1>

        <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-500">
            Découvrez les produits les plus appréciés et les plus souvent ajoutés aux favoris.
        </p>
    </div>

    {# Statistiques réelles #}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">

        <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-stone-500">Produits suivis</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">◇</span>
            </div>
            <p class="mt-4 text-3xl font-semibold text-stone-800">
                {{ stats.products }}
            </p>
            <p class="mt-2 text-xs text-stone-400">
                Produits ajoutés aux favoris
            </p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-stone-500">Total des favoris</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-xl text-rose-600">♡</span>
            </div>
            <p class="mt-4 text-3xl font-semibold text-stone-800">
                {{ stats.total }}
            </p>
            <p class="mt-2 text-xs text-stone-400">
                Favoris enregistrés en base de données
            </p>
        </div>

        <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-stone-500">Record de favoris</p>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">★</span>
            </div>
            <p class="mt-4 text-3xl font-semibold text-stone-800">
                {{ stats.top }}
            </p>
            <p class="mt-2 text-xs text-stone-400">
                Pour le produit le plus apprécié
            </p>
        </div>

    </div>

    {# Bloc éditorial #}
    <div class="flex flex-col gap-4 rounded-2xl border border-[#B08D67]/20 bg-[#F5F0E8] p-5 sm:flex-row sm:items-center sm:gap-5 sm:p-6">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white text-2xl text-[#B08D67]">
            ♡
        </div>

        <div>
            <h2 class="font-semibold text-stone-800">
                Ce que vos clients aiment
            </h2>
            <p class="mt-1 max-w-3xl text-sm leading-6 text-stone-600">
                Les favoris permettent d'identifier les articles qui suscitent le plus d'intérêt et d'orienter les prochaines collections.
            </p>
        </div>
    </div>

    {# Liste des produits favoris #}
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white">

        <div class="border-b border-stone-100 px-5 py-5 sm:px-6">
            <h2 class="font-semibold text-stone-800">
                Produits les plus ajoutés aux favoris
            </h2>
            <p class="mt-1 text-sm text-stone-500">
                Consultez les articles et leur nombre réel de favoris.
            </p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[760px] text-left text-sm">

                <thead class="bg-stone-50 text-xs uppercase tracking-wider text-stone-500">
                    <tr>
                        <th class="px-6 py-4 font-medium">Produit</th>
                        <th class="px-6 py-4 font-medium">Catégorie</th>
                        <th class="px-6 py-4 font-medium">Prix</th>
                        <th class="px-6 py-4 font-medium">Nombre de favoris</th>
                        <th class="px-6 py-4 font-medium">Popularité</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-stone-100">

                    {% for favorite in favorites %}
                        {% set product = favorite.product %}

                        <tr class="transition hover:bg-[#F5F0E8]/40">

                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">

                                    {% if product.mainImage %}
                                        <img
                                            src="{{ asset(product.mainImage) }}"
                                            alt="{{ product.name }}"
                                            class="h-16 w-14 rounded-xl border border-stone-100 bg-[#F5F0E8] object-cover"
                                        >
                                    {% else %}
                                        <div class="flex h-16 w-14 items-center justify-center rounded-xl border border-stone-100 bg-[#F5F0E8] text-stone-400">
                                            ◇
                                        </div>
                                    {% endif %}

                                    <div>
                                        <p class="font-semibold text-stone-800">
                                            {{ product.name }}
                                        </p>
                                        <p class="mt-1 text-xs text-stone-400">
                                            ID produit : #{{ product.id }}
                                        </p>
                                    </div>
                                </div>
                            </td>

                            <td class="px-6 py-4 text-stone-600">
                                {{ product.category.name }}
                            </td>

                            <td class="whitespace-nowrap px-6 py-4 font-medium text-stone-800">
                                {{ product.price|number_format(0, ',', ' ') }} Ar
                            </td>

                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-2 rounded-lg bg-rose-50 px-3 py-2 font-semibold text-rose-700">
                                    <span>♡</span>
                                    {{ favorite.count }}
                                </span>
                            </td>

                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="h-2 w-24 overflow-hidden rounded-full bg-stone-100">
                                        <div
                                            class="h-full rounded-full bg-[#B08D67]"
                                            style="width: {{ stats.top > 0 ? (favorite.count / stats.top * 100)|round : 0 }}%;"
                                        ></div>
                                    </div>

                                    {% if favorite.count >= stats.top * 0.75 and stats.top > 0 %}
                                        <span class="text-xs font-medium text-[#8A6848]">
                                            Très apprécié
                                        </span>
                                    {% elseif favorite.count >= stats.top * 0.40 and stats.top > 0 %}
                                        <span class="text-xs font-medium text-stone-600">
                                            Apprécié
                                        </span>
                                    {% else %}
                                        <span class="text-xs text-stone-500">
                                            À découvrir
                                        </span>
                                    {% endif %}
                                </div>
                            </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-16 text-center">
                                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#F5F0E8] text-2xl text-[#B08D67]">
                                    ♡
                                </div>

                                <h3 class="mt-4 font-semibold text-stone-800">
                                    Aucun favori pour le moment
                                </h3>

                                <p class="mt-2 text-sm text-stone-500">
                                    Les produits ajoutés aux favoris par les clients apparaîtront ici.
                                </p>
                            </td>
                        </tr>
                    {% endfor %}

                </tbody>
            </table>
        </div>

    </div>

</div>
{% endblock %}
