{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Gestion des commandes | ModeBoutique{% endblock %}

{% block admin_content %}

<div class="space-y-8">

    {# En-tête de la page #}
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
            Boutique
        </p>

        <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
            Gestion des commandes
        </h1>

        <p class="mt-2 text-sm text-stone-500">
            Suivez les commandes et leur état de traitement.
        </p>
    </div>

    {# Statistiques #}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

        {# Total des commandes #}
        <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-stone-500">Total commandes</p>

                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">
                    ▤
                </span>
            </div>

            <p class="mt-4 text-3xl font-semibold text-stone-800">
                {{ stats.total }}
            </p>

            <p class="mt-2 text-xs text-stone-400">
                Toutes les commandes enregistrées
            </p>
        </div>

        {# Commandes en attente #}
        <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-stone-500">En attente</p>

                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600">
                    ◷
                </span>
            </div>

            <p class="mt-4 text-3xl font-semibold text-amber-600">
                {{ stats.pending }}
            </p>

            <p class="mt-2 text-xs text-stone-400">
                Commandes à traiter
            </p>
        </div>

        {# Commandes en préparation #}
        <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-stone-500">En préparation</p>

                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-xl text-blue-600">
                    ◫
                </span>
            </div>

            <p class="mt-4 text-3xl font-semibold text-blue-600">
                {{ stats.processing }}
            </p>

            <p class="mt-2 text-xs text-stone-400">
                Commandes en cours de traitement
            </p>
        </div>

        {# Montant payé #}
        <div class="rounded-2xl border border-stone-200 bg-white p-5">
            <div class="flex items-center justify-between">
                <p class="text-sm text-stone-500">Montant payé</p>

                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600">
                    ₳
                </span>
            </div>

            <p class="mt-4 text-2xl font-semibold text-stone-800">
                {{ stats.revenue|number_format(0, ',', ' ') }} Ar
            </p>

            <p class="mt-2 text-xs text-stone-400">
                Total des paiements confirmés
            </p>
        </div>

    </div>

    {# Tableau des commandes #}
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white">

        {# Recherche et filtre #}
        <div class="border-b border-stone-100 p-5 sm:p-6">

            <div>
                <h2 class="font-semibold text-stone-800">
                    Toutes les commandes
                </h2>

                <p class="mt-1 text-sm text-stone-500">
                    Recherchez une commande ou filtrez par statut.
                </p>
            </div>

            <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">

                <input
                    id="order-search"
                    type="search"
                    placeholder="Rechercher une référence ou un client..."
                    class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                >

                <select
                    id="order-status"
                    class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-[#B08D67] focus:bg-white"
                >
                    <option value="">Tous les statuts</option>
                    <option value="en attente">En attente</option>
                    <option value="confirmée">Confirmée</option>
                    <option value="en préparation">En préparation</option>
                    <option value="expédiée">Expédiée</option>
                    <option value="livrée">Livrée</option>
                    <option value="annulée">Annulée</option>
                </select>

            </div>
        </div>

        {# Liste des commandes #}
        <div class="overflow-x-auto">

            <table class="w-full min-w-[1000px] text-left text-sm">

                <thead class="bg-stone-50 text-xs uppercase tracking-wider text-stone-500">
                    <tr>
                        <th class="px-6 py-4 font-medium">Commande</th>
                        <th class="px-6 py-4 font-medium">Client</th>
                        <th class="px-6 py-4 font-medium">Date</th>
                        <th class="px-6 py-4 font-medium">Montant</th>
                        <th class="px-6 py-4 font-medium">Paiement</th>
                        <th class="px-6 py-4 font-medium">Statut</th>
                        <th class="px-6 py-4 text-right font-medium">Action</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-stone-100" id="orders-table">

                    {% for order in orders %}

                        {% set status = order.status|lower %}

                        <tr
                            class="order-row transition hover:bg-[#F5F0E8]/40"
                            data-reference="{{ order.reference|lower }}"
                            data-client="{{ order.client|lower }}"
                            data-status="{{ order.status|lower }}"
                        >

                            {# Référence de la commande #}
                            <td class="px-6 py-5">
                                <p class="font-semibold text-stone-800">
                                    {{ order.reference }}
                                </p>

                                <p class="mt-1 text-xs text-stone-400">
                                    ModeBoutique
                                </p>
                            </td>

                            {# Informations du client #}
                            <td class="px-6 py-5">
                                <p class="font-medium text-stone-800">
                                    {{ order.client }}
                                </p>

                                <p class="mt-1 text-xs text-stone-500">
                                    {{ order.email }}
                                </p>
                            </td>

                            {# Date de la commande #}
                            <td class="whitespace-nowrap px-6 py-5 text-stone-500">
                                {{ order.date }}
                            </td>

                            {# Montant total #}
                            <td class="whitespace-nowrap px-6 py-5 font-semibold text-stone-800">
                                {{ order.total|number_format(0, ',', ' ') }} Ar
                            </td>

                            {# Statut du paiement #}
                            <td class="px-6 py-5">
                                {% if 'payé' in order.payment|lower %}
                                    <span class="inline-flex whitespace-nowrap rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700">
                                        {{ order.payment }}
                                    </span>
                                {% elseif 'attente' in order.payment|lower %}
                                    <span class="inline-flex whitespace-nowrap rounded-full bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700">
                                        {{ order.payment }}
                                    </span>
                                {% else %}
                                    <span class="inline-flex whitespace-nowrap rounded-full bg-stone-100 px-3 py-1.5 text-xs font-medium text-stone-600">
                                        {{ order.payment }}
                                    </span>
                                {% endif %}
                            </td>

                            {# Statut de la commande #}
                            <td class="px-6 py-5">

                                {% if status == 'livrée' %}
                                    <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700">
                                        {{ order.status }}

                                    </span>

                                {% elseif status == 'expédiée' %}
                                    <span class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700">
                                        {{ order.status }}
                                    </span>

                                {% elseif status == 'en préparation' %}
                                    <span class="rounded-full bg-violet-50 px-3 py-1.5 text-xs font-medium text-violet-700">
                                        {{ order.status }}
                                    </span>

                                {% elseif status == 'confirmée' %}
                                    <span class="rounded-full bg-sky-50 px-3 py-1.5 text-xs font-medium text-sky-700">
                                        {{ order.status }}
                                    </span>

                                {% elseif status == 'annulée' %}
                                    <span class="rounded-full bg-red-50 px-3 py-1.5 text-xs font-medium text-red-700">
                                        {{ order.status }}
                                    </span>

                                {% else %}
                                    <span class="rounded-full bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700">
                                        {{ order.status }}
                                    </span>
                                {% endif %}

                            </td>

                            {# Action : consulter les détails #}
                            <td class="px-6 py-5 text-right">

                                <a
                                    href="{{ path('admin_orders_show', {
                                        orderNumber: order.orderNumber
                                    }) }}"
                                    class="inline-flex items-center whitespace-nowrap rounded-lg border border-stone-200 px-3 py-2 text-xs font-medium text-stone-600 transition hover:border-[#B08D67] hover:text-[#B08D67]"
                                >
                                    Détails
                                    <span class="ml-1">→</span>
                                </a>

                            </td>

                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center">
                                <p class="font-medium text-stone-700">
                                    Aucune commande enregistrée
                                </p>

                                <p class="mt-2 text-sm text-stone-500">
                                    Les nouvelles commandes apparaîtront ici.
                                </p>
                            </td>
                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

        {# Message lorsque la recherche ne donne aucun résultat #}
        <div id="orders-empty" class="hidden px-6 py-12 text-center">
            <p class="font-medium text-stone-700">
                Aucune commande trouvée
            </p>

            <p class="mt-2 text-sm text-stone-500">
                Essayez une autre recherche ou un autre statut.
            </p>
        </div>

        {# Pied du tableau #}
        <div class="border-t border-stone-100 px-6 py-4">
            <p class="text-xs text-stone-400">
                {{ stats.total }} commande(s) enregistrée(s).
            </p>
        </div>

    </div>

</div>

{# Recherche et filtrage des commandes #}
<script>
    const orderSearch = document.getElementById('order-search');
    const orderStatus = document.getElementById('order-status');
    const orderRows = document.querySelectorAll('.order-row');
    const ordersEmpty = document.getElementById('orders-empty');

    function filterOrders() {
        const search = orderSearch.value.toLowerCase().trim();
        const status = orderStatus.value.toLowerCase();

        let visibleCount = 0;

        orderRows.forEach(row => {
            const reference = row.dataset.reference;
            const client = row.dataset.client;
            const rowStatus = row.dataset.status;

            const matchesSearch =
                reference.includes(search) ||
                client.includes(search);

            const matchesStatus =
                !status || rowStatus === status;

            const visible = matchesSearch && matchesStatus;

            row.classList.toggle('hidden', !visible);

            if (visible) {
                visibleCount++;
            }
        });

        ordersEmpty.classList.toggle(
            'hidden',
            visibleCount > 0 || orderRows.length === 0
        );
    }

    orderSearch.addEventListener('input', filterOrders);
    orderStatus.addEventListener('change', filterOrders);
</script>

{% endblock %}
