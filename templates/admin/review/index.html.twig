{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Avis clients | ModeBoutique{% endblock %}

{% block admin_content %}

    <div class="space-y-8">

        {# En-tête #}
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
                Relation client
            </p>

            <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
                Avis clients
            </h1>

            <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-500">
                Consultez les commentaires, les notes et les avis déposés sur les produits de ModeBoutique.
            </p>
        </div>

        {# Messages de confirmation et d'erreur #}
        {% for message in app.flashes('success') %}
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-800">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800">
                {{ message }}
            </div>
        {% endfor %}

        {# Statistiques dynamiques #}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Total des avis</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">
                        ★
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-stone-800">
                    {{ stats.total }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Avis enregistrés
                </p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Note moyenne</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-xl text-amber-600">
                        ★
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-stone-800">
                    {{ stats.average|number_format(1, ',', ' ') }}/5
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Moyenne des évaluations
                </p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Notes 5 étoiles</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600">
                        ✓
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-emerald-700">
                    {{ stats.fiveStars }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Avis très positifs
                </p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Notes faibles</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-50 text-xl text-red-600">
                        !
                    </span>
                </div>

                <p class="mt-4 text-3xl font-semibold text-red-600">
                    {{ stats.lowRatings }}
                </p>

                <p class="mt-2 text-xs text-stone-400">
                    Avis de 1 à 2 étoiles
                </p>
            </div>

        </div>

        {# Information #}
        <div class="flex items-start gap-4 rounded-2xl border border-[#B08D67]/20 bg-[#F5F0E8] p-5">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-xl text-[#B08D67]">
                ★
            </div>

            <div>
                <h2 class="font-semibold text-stone-800">
                    Qualité et confiance
                </h2>

                <p class="mt-1 text-sm leading-6 text-stone-600">
                    Consultez les retours des clients afin de suivre leur satisfaction
                    et d'identifier les produits qui nécessitent une attention particulière.
                </p>
            </div>
        </div>

        {# Liste des avis #}
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white">

            <div class="border-b border-stone-100 px-5 py-5 sm:px-6">
                <h2 class="font-semibold text-stone-800">
                    Tous les avis
                </h2>

                <p class="mt-1 text-sm text-stone-500">
                    Consultez les informations et le contenu de chaque commentaire.
                </p>
            </div>

            <div class="divide-y divide-stone-100">

                {% for review in reviews %}

                    {% set client = review.user %}
                    {% set product = review.product %}

                    <details class="group px-5 py-5 transition hover:bg-[#FCFAF7] sm:px-6">

                        {# Résumé de l'avis #}
                        <summary class="flex cursor-pointer list-none flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                            <div class="flex min-w-0 items-start gap-3">

                                {# Image du produit #}
                                {% if product.mainImage %}
                                    <img
                                        src="{{ asset(product.mainImage) }}"
                                        alt="{{ product.name }}"
                                        class="h-16 w-14 shrink-0 rounded-xl border border-stone-100 bg-[#F5F0E8] object-cover"
                                    >
                                {% else %}
                                    <div class="flex h-16 w-14 shrink-0 items-center justify-center rounded-xl border border-stone-100 bg-[#F5F0E8] text-2xl text-[#B08D67]">
                                        ◇
                                    </div>
                                {% endif %}

                                <div class="min-w-0">

                                    {# Client et photo de profil #}
                                    <div class="flex flex-wrap items-center gap-3">

                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[#F5F0E8] text-xs font-semibold text-stone-700">

                                            {% if client.profilePicture %}
                                                <img
                                                    src="{{ asset('uploads/profile/' ~ client.profilePicture) }}"
                                                    alt="Photo de profil de {{ client.firstname }}"
                                                    class="h-full w-full object-cover"
                                                >
                                            {% else %}
                                                {{ client.firstname|slice(0, 1)|upper }}{{ client.lastname|slice(0, 1)|upper }}
                                            {% endif %}

                                        </div>

                                        <p class="font-semibold text-stone-800">
                                            {{ client.firstname }} {{ client.lastname }}
                                        </p>

                                    </div>

                                    {# Produit concerné #}
                                    <p class="mt-2 truncate text-xs text-stone-500">
                                        {{ product.name }}
                                    </p>

                                    {# Note #}
                                    <div class="mt-1 flex flex-wrap items-center gap-2">

                                        <span class="text-sm tracking-wider text-[#B08D67]">
                                            {% for star in 1..5 %}
                                                {{ star <= review.rating ? '★' : '☆' }}
                                            {% endfor %}
                                        </span>

                                        <span class="text-xs text-stone-400">
                                            {{ review.rating }}/5
                                        </span>

                                    </div>

                                    {# Extrait du commentaire #}
                                    <p class="mt-2 text-sm leading-5 text-stone-500">
                                        {% if review.comment %}
                                            {{ review.comment|length > 100
                                                ? review.comment|slice(0, 100) ~ '…'
                                                : review.comment
                                            }}
                                        {% else %}
                                            Aucun commentaire.
                                        {% endif %}
                                    </p>

                                </div>
                            </div>

                            {# Date et bouton de détail #}
                            <div class="flex shrink-0 items-center justify-between gap-4 sm:flex-col sm:items-end">

                                <span class="text-xs text-stone-400">
                                    {{ review.createdAt|date('d/m/Y') }}
                                </span>

                                <span class="text-sm font-medium text-[#8A6848] group-open:hidden">
                                    Lire l'avis ↓
                                </span>

                                <span class="hidden text-sm font-medium text-[#8A6848] group-open:inline">
                                    Fermer ↑
                                </span>

                            </div>

                        </summary>

                        {# Détails de l'avis #}
                        <div class="ml-0 mt-5 rounded-xl border border-stone-100 bg-[#FCFAF7] p-4 sm:ml-[4.25rem] sm:p-5">

                            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">

                                <div>
                                    <p class="text-xs text-stone-400">
                                        Client
                                    </p>

                                    <p class="mt-1 text-sm font-medium text-stone-700">
                                        {{ client.firstname }} {{ client.lastname }}
                                    </p>

                                    <p class="mt-1 text-sm text-stone-500">
                                        {{ client.email }}
                                    </p>
                                </div>

                                <div>
                                    <p class="text-xs text-stone-400">
                                        Produit concerné
                                    </p>

                                    <p class="mt-1 text-sm font-medium text-stone-700">
                                        {{ product.name }}
                                    </p>

                                    <p class="mt-1 text-sm text-stone-500">
                                        Publié le {{ review.createdAt|date('d/m/Y à H:i') }}
                                    </p>
                                </div>

                            </div>

                            {# Commentaire complet #}
                            <div class="mt-5 border-t border-stone-200 pt-4">

                                <p class="text-xs font-semibold uppercase tracking-wider text-stone-400">
                                    Commentaire du client
                                </p>

                                <p class="mt-3 whitespace-pre-line text-sm leading-7 text-stone-700">
                                    {{ review.comment ?: 'Aucun commentaire ajouté.' }}
                                </p>

                            </div>

                            {# Action de suppression #}
                            <div class="mt-5 flex flex-wrap justify-end gap-3 border-t border-stone-200 pt-4">

                                <form
                                    method="post"
                                    action="{{ path('admin_reviews_delete', {id: review.id}) }}"
                                >

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('delete_review_' ~ review.id) }}"
                                    >

                                    <button
                                        type="submit"
                                        class="rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 text-sm font-medium text-red-700 transition hover:bg-red-100"
                                    >
                                        Supprimer l'avis
                                    </button>

                                </form>

                            </div>

                        </div>

                    </details>

                {% else %}

                    {# Aucun avis #}
                    <div class="px-6 py-12 text-center">

                        <div class="text-4xl text-[#B08D67]">
                            ☆
                        </div>

                        <p class="mt-4 font-medium text-stone-700">
                            Aucun avis pour le moment
                        </p>

                        <p class="mt-2 text-sm text-stone-500">
                            Les avis reçus apparaîtront ici.
                        </p>

                    </div>

                {% endfor %}

            </div>

        </div>

    </div>

{% endblock %}
