{% extends 'layouts/admin-layout.html.twig' %}

{% block title %}Gestion des promotions | ModeBoutique{% endblock %}

{% block admin_content %}
    <div class="space-y-8">

        {# En-tête #}
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-[#B08D67]">
                    Marketing
                </p>

                <h1 class="mt-2 text-2xl font-semibold text-stone-800 sm:text-3xl">
                    Promotions & codes promo
                </h1>

                <p class="mt-2 text-sm text-stone-500">
                    Gérez vos réductions et offres spéciales pour vos clients.
                </p>
            </div>

            <a
                href="{{ path('admin_promotions_new') }}"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-stone-800 px-5 py-3 text-sm font-medium text-white transition hover:bg-[#B08D67]"
            >
                <span class="text-lg">+</span>
                Nouvelle promotion
            </a>
        </div>

        {# Messages de confirmation #}
        {% for message in app.flashes('success') %}
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-700">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-700">
                {{ message }}
            </div>
        {% endfor %}

        {# Statistiques #}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Total promotions</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">%</span>
                </div>
                <p class="mt-4 text-3xl font-semibold text-stone-800">{{ stats.total }}</p>
                <p class="mt-2 text-xs text-stone-400">Promotions enregistrées</p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Promotions actives</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-xl text-emerald-600">✓</span>
                </div>
                <p class="mt-4 text-3xl font-semibold text-emerald-700">{{ stats.active }}</p>
                <p class="mt-2 text-xs text-stone-400">Offres actuellement disponibles</p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Promotions expirées</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-stone-100 text-xl text-stone-500">◷</span>
                </div>
                <p class="mt-4 text-3xl font-semibold text-stone-700">{{ stats.expired }}</p>
                <p class="mt-2 text-xs text-stone-400">Offres terminées</p>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <div class="flex items-center justify-between">
                    <p class="text-sm text-stone-500">Utilisations</p>
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#F5F0E8] text-xl text-[#B08D67]">↗</span>
                </div>
                <p class="mt-4 text-3xl font-semibold text-stone-800">{{ stats.uses }}</p>
                <p class="mt-2 text-xs text-stone-400">Utilisations réelles cumulées</p>
            </div>

        </div>

        {# Bloc information #}
        <div class="flex flex-col gap-4 rounded-2xl border border-[#B08D67]/20 bg-[#F5F0E8] p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
            <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white text-2xl text-[#B08D67]">
                    ✦
                </div>
                <div>
                    <h2 class="font-semibold text-stone-800">Donnez envie de découvrir la collection</h2>
                    <p class="mt-1 max-w-2xl text-sm leading-6 text-stone-600">
                        Les codes promotionnels permettent de proposer des réductions ponctuelles à vos clients.
                    </p>
                </div>
            </div>
        </div>

        {# Tableau des promotions #}
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white">

            <div class="border-b border-stone-100 px-5 py-5 sm:px-6">
                <h2 class="font-semibold text-stone-800">Toutes les promotions</h2>
                <p class="mt-1 text-sm text-stone-500">
                    Consultez les codes, les réductions et les périodes de validité.
                </p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[950px] text-left text-sm">

                    <thead class="bg-stone-50 text-xs uppercase tracking-wider text-stone-500">
                        <tr>
                            <th class="px-6 py-4 font-medium">Promotion</th>
                            <th class="px-6 py-4 font-medium">Code promo</th>
                            <th class="px-6 py-4 font-medium">Réduction</th>
                            <th class="px-6 py-4 font-medium">Période</th>
                            <th class="px-6 py-4 font-medium">Utilisations</th>
                            <th class="px-6 py-4 font-medium">Statut</th>
                            <th class="px-6 py-4 text-center font-medium">Actions</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-stone-100">

                        {% for promotion in promotions %}
                            <tr class="transition hover:bg-[#F5F0E8]/40">

                                <td class="px-6 py-5">
                                    <p class="font-semibold text-stone-800">
                                        {{ promotion.name }}
                                    </p>
                                    <p class="mt-1 text-xs text-stone-400">
                                        {{ promotion.type }}
                                    </p>
                                </td>

                                <td class="px-6 py-5">
                                    <span class="inline-flex rounded-lg border border-dashed border-[#B08D67]/50 bg-[#F5F0E8] px-3 py-2 font-mono text-xs font-semibold tracking-wide text-[#8A6848]">
                                        {{ promotion.code }}
                                    </span>
                                </td>

                                <td class="whitespace-nowrap px-6 py-5 font-semibold text-stone-800">
                                    {{ promotion.discount }}
                                </td>

                                <td class="whitespace-nowrap px-6 py-5 text-stone-500">
                                    <p>{{ promotion.start }}</p>
                                    <p class="mt-1 text-xs text-stone-400">
                                        au {{ promotion.end }}
                                    </p>
                                </td>

                                <td class="px-6 py-5">
                                    <p class="font-medium text-stone-800">
                                        {{ promotion.usage }}
                                        <span class="font-normal text-stone-400">
                                            / {{ promotion.limit is not null ? promotion.limit : 'Illimité' }}
                                        </span>
                                    </p>

                                    {% if promotion.limit is not null and promotion.limit > 0 %}
                                        <div class="mt-2 h-1.5 w-24 overflow-hidden rounded-full bg-stone-100">
                                            <div
                                                class="h-full rounded-full bg-[#B08D67]"
                                                style="width: {{ promotion.usagePercent }}%;"
                                            ></div>
                                        </div>
                                    {% endif %}
                                </td>

                                <td class="px-6 py-5">
                                    {% if promotion.status == 'Active' %}
                                        <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-700">
                                            Active
                                        </span>
                                    {% elseif promotion.status == 'À venir' %}
                                        <span class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700">
                                            À venir
                                        </span>
                                    {% elseif promotion.status == 'Inactive' %}
                                        <span class="rounded-full bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700">
                                            Inactive
                                        </span>
                                    {% else %}
                                        <span class="rounded-full bg-stone-100 px-3 py-1.5 text-xs font-medium text-stone-500">
                                            Expirée
                                        </span>
                                    {% endif %}
                                </td>

                                
                                {# Actions : modifier et supprimer #}
                                <td class="whitespace-nowrap px-6 py-5">
                                    <div class="flex items-center justify-end gap-2">

                                        {# Modifier #}
                                        <a
                                            href="{{ path('admin_promotions_edit', {id: promotion.id}) }}"
                                            title="Modifier la promotion"
                                            aria-label="Modifier {{ promotion.name }}"
                                            class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-[#E8DED3] bg-white text-[#8C6038] transition hover:bg-[#F5F0E8] hover:text-[#292524]"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="1.8"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                aria-hidden="true"
                                            >
                                                <path d="M12 20h9"/>
                                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/>
                                            </svg>
                                        </a>

                                        {# Supprimer #}
                                        <form
                                            method="POST"
                                            action="{{ path('admin_promotions_delete', {id: promotion.id}) }}"
                                            data-turbo="false"
                                            onsubmit="return confirm('Voulez-vous vraiment supprimer cette promotion ?');"
                                        >
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete_promotion_' ~ promotion.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                title="Supprimer la promotion"
                                                aria-label="Supprimer {{ promotion.name }}"
                                                class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-red-200 bg-white text-red-600 transition hover:bg-red-50 hover:text-red-700"
                                            >
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="18"
                                                    height="18"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="1.8"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    aria-hidden="true"
                                                >
                                                    <path d="M3 6h18"/>
                                                    <path d="M8 6V4h8v2"/>
                                                    <path d="m19 6-1 14H6L5 6"/>
                                                    <path d="M10 11v5"/>
                                                    <path d="M14 11v5"/>
                                                </svg>
                                            </button>
                                        </form>

                                    </div>
                                </td>


                            </tr>

                        {% else %}
                            <tr>
                                <td colspan="7" class="px-6 py-12 text-center">
                                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#F5F0E8] text-2xl text-[#B08D67]">
                                        %
                                    </div>
                                    <p class="mt-4 font-medium text-stone-700">
                                        Aucune promotion pour le moment
                                    </p>
                                    <p class="mt-1 text-sm text-stone-400">
                                        Créez votre première promotion pour commencer.
                                    </p>
                                    <a
                                        href="{{ path('admin_promotions_new') }}"
                                        class="mt-4 inline-flex rounded-xl bg-stone-800 px-5 py-3 text-sm font-medium text-white transition hover:bg-[#B08D67]"
                                    >
                                        Créer une promotion
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}

                    </tbody>
                </table>
            </div>

        </div>
    </div>
{% endblock %}
