{% extends 'layouts/base.html.twig' %}

{% block title %}Questions fréquentes | ModeBoutique{% endblock %}

{% block body %}

<section class="bg-cream py-16 sm:py-20">
    <div class="container-page px-5">

        {# En-tête #}
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                Centre d'aide
            </p>

            <h1 class="mt-4 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                Questions fréquentes
            </h1>

            <p class="mt-5 text-sm leading-7 text-ink-soft sm:text-base">
                Retrouvez les réponses aux questions les plus fréquentes
                concernant vos commandes, la livraison et le paiement.
            </p>
        </div>

        {# Liste des questions #}
        <div class="mx-auto mt-14 max-w-3xl space-y-10">

            {% for category in faqCategories %}
                <div>
                    <h2 class="mb-5 border-b border-stone-300 pb-3 font-serif text-2xl font-semibold text-ink">
                        {{ category.title }}
                    </h2>

                    <div class="space-y-3">
                        {% for item in category.questions %}
                            <details class="group rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition hover:border-brand/50">
                                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-ink">
                                    <span>{{ item.question }}</span>

                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cream text-brand transition group-open:rotate-180">
                                        <twig:ux:icon name="lucide:chevron-down" class="h-4 w-4" />
                                    </span>
                                </summary>

                                <p class="mt-4 border-t border-stone-100 pt-4 text-sm leading-7 text-ink-soft">
                                    {{ item.answer }}
                                </p>
                            </details>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

        </div>

        {# Contact #}
        <div class="mx-auto mt-16 max-w-3xl rounded-2xl bg-[#292524] px-6 py-10 text-center sm:px-10">
            <h2 class="font-serif text-2xl font-semibold text-white">
                Vous n'avez pas trouvé votre réponse ?
            </h2>

            <p class="mt-3 text-sm leading-7 text-stone-300">
                Notre équipe est disponible pour répondre à vos questions
                et vous accompagner.
            </p>

            <a
                href="{{ path('app_contact') }}"
                class="mt-6 inline-flex items-center justify-center rounded-full bg-[#B08D67] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#9B7956]"
            >
                Contacter notre équipe
            </a>
        </div>

        <div class="mt-8 text-center">
            <a
                href="{{ path('home') }}"
                class="text-sm font-medium text-brand transition hover:underline"
            >
                ← Retour à l'accueil
            </a>
        </div>

    </div>
</section>

{% endblock %}
