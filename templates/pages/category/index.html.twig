{% extends 'layouts/base.html.twig' %}

{% block title %}Catégories | ModeBoutique{% endblock %}

{% block body %}
    <main class="min-h-screen bg-white text-ink">

        {# En-tête #}
        <section class="bg-white py-10 sm:py-14">
            <div class="container-page text-center">

                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-brand">
                    Explorez notre univers
                </p>

                <h1 class="font-serif text-3xl font-bold sm:text-5xl">
                    {% if currentGenre and currentType and selectedSubcategory %}
                        {{ selectedSubcategory.name }}
                    {% elseif currentGenre and currentType %}
                        {{ collections[currentGenre].name }} · {{ collections[currentGenre].categories[currentType].name }}
                    {% elseif currentGenre %}
                        Collection {{ collections[currentGenre].name }}
                    {% else %}
                        Nos catégories
                    {% endif %}
                </h1>

                <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-ink-soft sm:text-base">
                    {% if currentGenre and currentType and selectedSubcategory %}
                        {{ selectedSubcategory.description }}
                    {% elseif currentGenre and currentType %}
                        Découvrez nos collections {{ collections[currentGenre].categories[currentType].name|lower }} pour {{ collections[currentGenre].name|lower }}.
                    {% elseif currentGenre %}
                        {{ collections[currentGenre].description }}
                    {% else %}
                        Découvrez nos collections pour femme et homme et trouvez les pièces qui correspondent à votre style.
                    {% endif %}
                </p>

                {# Navigation rapide #}
                <div class="mt-7 flex flex-wrap justify-center gap-3">
                    <a
                        href="{{ path('app_category') }}"
                        class="rounded-full border border-ink/10 px-5 py-2.5 text-sm font-semibold transition hover:bg-brand-light hover:text-brand"
                    >
                        Toutes les catégories
                    </a>

                    <a
                        href="{{ path('app_category', {'genre': 'femme'}) }}"
                        class="rounded-full bg-brand-light px-5 py-2.5 text-sm font-semibold text-brand transition hover:bg-brand hover:text-white"
                    >
                        Femme
                    </a>

                    <a
                        href="{{ path('app_category', {'genre': 'homme'}) }}"
                        class="rounded-full bg-brand-light px-5 py-2.5 text-sm font-semibold text-brand transition hover:bg-brand hover:text-white"
                    >
                        Homme
                    </a>
                </div>

            </div>
        </section>

        {# Fil d'Ariane lorsque l'on navigue dans les sous-catégories #}
        {% if currentGenre %}
            <div class="border-y border-ink/10 bg-cream/60">
                <div class="container-page flex flex-wrap items-center gap-2 py-4 text-sm text-ink-soft">

                    <a href="{{ path('app_category') }}" class="hover:text-brand">
                        Catégories
                    </a>

                    <span>/</span>

                    <a
                        href="{{ path('app_category', {'genre': currentGenre}) }}"
                        class="hover:text-brand"
                    >
                        {{ collections[currentGenre].name }}
                    </a>

                    {% if currentType %}
                        <span>/</span>
                        <a
                            href="{{ path('app_category', {'genre': currentGenre, 'type': currentType}) }}"
                            class="hover:text-brand"
                        >
                            {{ collections[currentGenre].categories[currentType].name }}
                        </a>
                    {% endif %}

                    {% if selectedSubcategory %}
                        <span>/</span>
                        <span class="font-semibold text-ink">
                            {{ selectedSubcategory.name }}
                        </span>
                    {% endif %}

                </div>
            </div>
        {% endif %}

        {# NIVEAU 1 : toutes les collections Femme et Homme #}
        {% if currentGenre == '' %}

            {% for collectionSlug, collection in collections %}
                <section
                    id="{{ collectionSlug }}"
                    class="{{ loop.first ? 'bg-cream' : 'bg-white' }} py-10 sm:py-16"
                >

                    <div class="container-page">

                        {# Bannière de collection #}
                        <div class="relative isolate flex min-h-[290px] items-center overflow-hidden rounded-2xl bg-ink sm:min-h-[350px]">

                            <img
                                src="{{ collection.image }}"
                                alt="Collection {{ collection.name }}"
                                class="absolute inset-0 -z-20 h-full w-full object-cover"
                                loading="lazy"
                            >

                            <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/85 via-ink/50 to-transparent"></div>

                            <div class="max-w-xl p-6 sm:p-10">
                                <p class="text-sm font-semibold uppercase tracking-widest text-brand-light">
                                    {{ collection.eyebrow }}
                                </p>

                                <h2 class="mt-3 font-serif text-4xl font-bold text-white sm:text-5xl">
                                    {{ collection.name }}
                                </h2>

                                <p class="mt-4 text-sm leading-6 text-white/90 sm:text-base">
                                    {{ collection.description }}
                                </p>

                                <a
                                    href="{{ path('app_category', {'genre': collectionSlug}) }}"
                                    class="mt-6 inline-flex rounded-xl bg-white px-5 py-3 text-sm font-semibold text-ink transition hover:bg-brand-light"
                                >
                                    Explorer la collection
                                </a>
                            </div>
                        </div>

                        <div class="mt-10">
                            <h3 class="font-serif text-2xl font-bold sm:text-3xl">
                                {{ collection.name }} : nos collections
                            </h3>

                            <p class="mt-2 text-sm text-ink-soft">
                                Choisissez une catégorie pour affiner votre recherche.
                            </p>
                        </div>

                        <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

                            {% for typeSlug, category in collection.categories %}
                                <a
                                    href="{{ path('app_category', {'genre': collectionSlug, 'type': typeSlug}) }}"
                                    class="group overflow-hidden rounded-2xl border border-ink/10 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg"
                                >

                                    <div class="overflow-hidden bg-cream">
                                        <img
                                            src="{{ category.image }}"
                                            alt="{{ category.name }} {{ collection.name }}"
                                            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
                                            loading="lazy"
                                        >
                                    </div>

                                    <div class="p-5">
                                        <h4 class="font-serif text-xl font-bold group-hover:text-brand">
                                            {{ category.name }}
                                        </h4>

                                        <p class="mt-2 text-sm leading-6 text-ink-soft">
                                            {{ category.description }}
                                        </p>

                                        <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand">
                                            Découvrir
                                            <span>→</span>
                                        </span>
                                    </div>
                                </a>
                            {% endfor %}

                        </div>
                    </div>
                </section>
            {% endfor %}

            {# NIVEAU 2 : Femme ou Homme, puis Vêtements, Chaussures, Accessoires #}
        {% elseif currentGenre and currentType == '' %}

            {% set collection = collections[currentGenre] %}

            <section class="bg-cream py-10 sm:py-14">
                <div class="container-page">

                    <div class="relative isolate flex min-h-[260px] items-center overflow-hidden rounded-2xl bg-ink sm:min-h-[320px]">
                        <img
                            src="{{ collection.image }}"
                            alt="Collection {{ collection.name }}"
                            class="absolute inset-0 -z-20 h-full w-full object-cover"
                            loading="lazy"
                        >

                        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/85 via-ink/50 to-transparent"></div>

                        <div class="max-w-xl p-6 sm:p-10">
                            <p class="text-sm font-semibold uppercase tracking-widest text-brand-light">
                                {{ collection.eyebrow }}
                            </p>

                            <h2 class="mt-3 font-serif text-4xl font-bold text-white sm:text-5xl">
                                {{ collection.name }}
                            </h2>

                            <p class="mt-4 text-sm leading-6 text-white/90">
                                {{ collection.description }}
                            </p>
                        </div>
                    </div>

                    <h2 class="mt-10 font-serif text-2xl font-bold sm:text-3xl">
                        Catégories {{ collection.name|lower }}
                    </h2>

                    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

                        {% for typeSlug, category in collection.categories %}
                            <a
                                href="{{ path('app_category', {'genre': currentGenre, 'type': typeSlug}) }}"
                                class="group overflow-hidden rounded-2xl border border-ink/10 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg"
                            >

                                <div class="overflow-hidden bg-cream">
                                    <img
                                        src="{{ category.image }}"
                                        alt="{{ category.name }}"
                                        class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105"
                                        loading="lazy"
                                    >
                                </div>

                                <div class="p-5">
                                    <h3 class="font-serif text-xl font-bold group-hover:text-brand">
                                        {{ category.name }}
                                    </h3>

                                    <p class="mt-2 text-sm leading-6 text-ink-soft">
                                        {{ category.description }}
                                    </p>

                                    <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand">
                                        Explorer
                                        <span>→</span>
                                    </span>
                                </div>
                            </a>
                        {% endfor %}

                    </div>
                </div>
            </section>

            {# NIVEAU 3 : sous-catégories telles que Robes, Pantalons ou Sneakers #}
        {% elseif currentGenre and currentType and selectedSubcategory == null %}

            {% set category = collections[currentGenre].categories[currentType] %}

            <section class="bg-cream py-10 sm:py-14">
                <div class="container-page">

                    <div class="rounded-2xl border border-ink/10 bg-white p-6 sm:p-8">
                        <p class="text-sm font-semibold uppercase tracking-widest text-brand">
                            {{ collections[currentGenre].name }}
                        </p>

                        <h2 class="mt-2 font-serif text-2xl font-bold sm:text-3xl">
                            {{ category.name }}
                        </h2>

                        <p class="mt-3 max-w-2xl text-sm leading-6 text-ink-soft">
                            {{ category.description }}
                        </p>
                    </div>

                    <h3 class="mt-8 font-serif text-2xl font-bold">
                        Découvrez nos sous-catégories
                    </h3>

                    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

                        {% for subcategory in category.subcategories %}
                            <a
                                href="{{ path('app_category', {
                            'genre': currentGenre,
                            'type': currentType,
                            'sousCategorie': subcategory.slug
                        }) }}"
                                class="group flex items-center justify-between gap-4 rounded-2xl border border-ink/10 bg-white p-5 transition hover:border-brand/40 hover:bg-brand-light/40 hover:shadow-md"
                            >

                                <div>
                                    <h4 class="font-serif text-xl font-bold text-ink transition group-hover:text-brand">
                                        {{ subcategory.name }}
                                    </h4>

                                    <p class="mt-2 text-sm leading-6 text-ink-soft">
                                        {{ subcategory.description }}
                                    </p>
                                </div>

                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-light text-lg text-brand transition group-hover:bg-brand group-hover:text-white">
                                    →
                                </span>
                            </a>
                        {% endfor %}

                    </div>
                </div>
            </section>

            {# NIVEAU 4 : catégorie sélectionnée #}
        {% else %}

            {% set collection = collections[currentGenre] %}
            {% set category = collection.categories[currentType] %}

            <section class="bg-cream py-10 sm:py-14">
                <div class="container-page">

                    <div class="grid grid-cols-1 items-center gap-8 overflow-hidden rounded-2xl border border-ink/10 bg-white md:grid-cols-2">

                        <div class="overflow-hidden">
                            <img
                                src="{{ selectedSubcategory.image }}"
                                alt="{{ selectedSubcategory.name }}"
                                class="min-h-[250px] w-full object-cover sm:min-h-[350px]"
                            >
                        </div>

                        <div class="p-6 sm:p-10">
                            <p class="text-sm font-semibold uppercase tracking-widest text-brand">
                                {{ collection.name }} · {{ category.name }}
                            </p>

                            <h2 class="mt-3 font-serif text-3xl font-bold sm:text-4xl">
                                {{ selectedSubcategory.name }}
                            </h2>

                            <p class="mt-4 text-sm leading-7 text-ink-soft">
                                {{ selectedSubcategory.description }}
                            </p>

                            <p class="mt-5 text-sm leading-6 text-ink-soft">
                                Cette catégorie est prête pour accueillir les produits correspondants.
                                L'affichage et le filtrage des produits seront reliés au catalogue lors de l'étape suivante.
                            </p>

                            <div class="mt-7 flex flex-wrap gap-3">
                                <a
                                    href="{{ path('app_shop', {
                                    genre: currentGenre,
                                    type: currentType,
                                    sousCategorie: currentSubcategory
                                }) }}"
                                    class="inline-flex items-center justify-center rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90"
                                >
                                    Voir les produits
                                </a>

                                <a
                                    href="{{ path('app_category', {'genre': currentGenre, 'type': currentType}) }}"
                                    class="inline-flex items-center justify-center rounded-xl border border-ink/15 px-5 py-3 text-sm font-semibold text-ink transition hover:bg-brand-light"
                                >
                                    Autres sous-catégories
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

        {% endif %}

        {# Appel à l'action #}
        <section class="bg-ink py-14 sm:py-20">
            <div class="container-page text-center">

                <p class="text-sm font-semibold uppercase tracking-widest text-brand-light">
                    ModeBoutique
                </p>

                <h2 class="mt-4 font-serif text-3xl font-bold text-white sm:text-4xl">
                    Trouvez votre prochain coup de cœur
                </h2>

                <p class="mx-auto mt-4 max-w-xl text-sm leading-6 text-white/75 sm:text-base">
                    Parcourez nos collections et découvrez les pièces qui vous ressemblent.
                </p>

                <div class="mt-7">
                    <a
                        href="{{ path('app_shop') }}"
                        class="inline-flex rounded-xl bg-white px-6 py-3 text-sm font-semibold text-ink transition hover:bg-brand-light"
                    >
                        Voir la boutique
                    </a>
                </div>

            </div>
        </section>

    </main>
{% endblock %}
