{% extends 'layouts/base.html.twig' %}

{% block title %}Nos promotions — ModeBoutique{% endblock %}

{% block meta_description %}
    Découvrez les promotions et les offres disponibles sur ModeBoutique.
{% endblock %}

{% block body %}

<section class="bg-cream py-16 sm:py-20">
    <div class="container-page">

        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                Sélection promotionnelle
            </p>

            <h1 class="mt-3 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                Nos promotions
            </h1>

            <p class="mt-4 text-base leading-relaxed text-ink-soft">
                Profitez de nos offres actuellement disponibles sur une sélection de produits.
            </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

            {% for product in promotedProducts %}

                {% if product.mainImage %}
                    {% if product.mainImage starts with 'http://' or product.mainImage starts with 'https://' %}
                        {% set imageUrl = product.mainImage %}
                    {% elseif product.mainImage starts with '/' %}
                        {% set imageUrl = product.mainImage %}
                    {% elseif product.mainImage starts with 'images/' or product.mainImage starts with 'uploads/' %}
                        {% set imageUrl = asset(product.mainImage) %}
                    {% else %}
                        {% set imageUrl = asset('images/products/' ~ product.mainImage) %}
                    {% endif %}
                {% else %}
                    {% set imageUrl = asset('images/products/sac-beige.jpg') %}
                {% endif %}

                <twig:ProductCard
                    productId="{{ product.id }}"
                    name="{{ product.name }}"
                    category="{{ product.category ? product.category.name : 'Sans catégorie' }}"
                    price="{{ productPricing[product.id].price|number_format(0, ',', ' ') ~ ' Ar' }}"
                    oldPrice="{{ productPricing[product.id].oldPrice is not null ? (productPricing[product.id].oldPrice|number_format(0, ',', ' ') ~ ' Ar') : '' }}"
                    discountBadge="{{ productPricing[product.id].discountBadge|default('') }}"
                    badge="Promotion"
                    image="{{ imageUrl }}"
                    href="{{ path('app_product_detail', {slug: product.slug}) }}"
                />

            {% else %}

                <div class="rounded-2xl border border-stone-200 bg-white p-8 text-center sm:col-span-2 lg:col-span-4">
                    <h2 class="font-serif text-xl font-semibold text-ink">
                        Aucune promotion disponible
                    </h2>

                    <p class="mt-3 text-sm text-ink-soft">
                        Revenez prochainement pour découvrir nos nouvelles offres.
                    </p>

                    <a href="{{ path('app_shop') }}"
                       class="mt-5 inline-flex rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90">
                        Découvrir la boutique
                    </a>
                </div>

            {% endfor %}

        </div>

        <div class="mt-10 text-center">
            <a href="{{ path('app_shop') }}"
               class="inline-flex rounded-full border border-brand px-6 py-3 text-sm font-semibold text-brand transition hover:bg-brand hover:text-white">
                Voir tous les produits
            </a>
        </div>

    </div>
</section>

{% endblock %}
