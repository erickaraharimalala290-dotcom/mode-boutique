{% extends 'layouts/base.html.twig' %}

{% block title %}À propos | ModeBoutique{% endblock %}

{% block body %}

{# ==========================================================
   SECTION 1 : HERO — Présentation principale
   ========================================================== #}
<section class="relative overflow-hidden bg-cream">
    <div class="container-page grid items-center gap-12 py-16 sm:py-20 md:py-24 lg:grid-cols-2 lg:gap-16">

        {# Texte de présentation #}
        <div>
            <p class="mb-5 text-xs font-semibold uppercase tracking-[0.25em] text-brand">
                Notre histoire
            </p>

            <h1 class="max-w-xl text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl lg:text-6xl">
                Le style qui vous ressemble,
                <span class="text-brand">chaque jour.</span>
            </h1>

            <p class="mt-6 max-w-lg text-base leading-8 text-ink-soft sm:text-lg">
                Bienvenue chez ModeBoutique, votre destination pour découvrir
                des vêtements, des chaussures et des accessoires qui mettent
                en valeur votre personnalité.
            </p>

            <div class="mt-8 flex flex-wrap gap-4">
                <twig:Button
                    variant="primary"
                    size="md"
                    href="{{ path('app_category') }}"
                >
                    Découvrir nos catégories
                </twig:Button>

                <twig:Button
                    variant="outline"
                    size="md"
                    href="{{ path('app_contact') }}"
                >
                    Nous contacter
                </twig:Button>
            </div>
        </div>

        {# Images des produits #}
        <div class="relative mx-auto w-full max-w-lg">
            <div class="absolute -right-4 -top-4 h-32 w-32 rounded-full bg-brand/20 blur-2xl"></div>
            <div class="absolute -bottom-5 -left-5 h-32 w-32 rounded-full bg-beige/70 blur-2xl"></div>

            <div class="relative grid grid-cols-2 gap-4">
                <div class="overflow-hidden rounded-t-full rounded-b-2xl bg-white p-2 shadow-lg">
                    <img
                        src="{{ asset('images/products/robe-soirée-marron.jpg') }}"
                        alt="Robe élégante proposée par ModeBoutique"
                        class="h-64 w-full rounded-t-full rounded-b-xl object-cover sm:h-80"
                    >
                </div>

                <div class="mt-12 overflow-hidden rounded-t-full rounded-b-2xl bg-white p-2 shadow-lg">
                    <img
                        src="{{ asset('images/products/sneakers-femme-noir.jpg') }}"
                        alt="Chaussures tendance proposées par ModeBoutique"
                        class="h-64 w-full rounded-t-full rounded-b-xl object-cover sm:h-80"
                    >
                </div>
            </div>

            <div class="absolute bottom-5 left-1/2 w-max max-w-[90%] -translate-x-1/2 rounded-2xl border border-beige bg-white/95 px-5 py-3 shadow-lg backdrop-blur">
                <p class="text-sm font-semibold text-ink">
                    ModeBoutique
                </p>
                <p class="mt-1 text-xs text-ink-soft">
                    Votre style, votre identité.
                </p>
            </div>
        </div>

    </div>
</section>


{# ==========================================================
   SECTION 2 : QUI SOMMES-NOUS ?
   ========================================================== #}
<section class="bg-white px-5 py-16 sm:px-8 md:py-24">
    <div class="mx-auto max-w-4xl text-center">

        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
            Qui sommes-nous ?
        </p>

        <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
            La mode accessible, avec élégance.
        </h2>

        <p class="mx-auto mt-6 max-w-3xl text-base leading-8 text-ink-soft">
            ModeBoutique est une boutique en ligne dédiée à la mode.
            Nous souhaitons vous aider à trouver facilement des pièces
            adaptées à votre style, à vos envies et à votre quotidien.
        </p>

        <p class="mx-auto mt-4 max-w-3xl text-base leading-8 text-ink-soft">
            Des vêtements aux chaussures, en passant par les accessoires,
            notre objectif est de vous offrir une expérience d'achat simple,
            agréable et pratique, où que vous soyez.
        </p>

    </div>
</section>


{# ==========================================================
   SECTION 3 : NOS VALEURS
   ========================================================== #}
<section class="bg-cream px-5 py-16 sm:px-8 md:py-24">
    <div class="mx-auto max-w-7xl">

        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                Nos engagements
            </p>

            <h2 class="mt-4 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
                Ce qui nous tient à cœur
            </h2>

            <p class="mt-5 leading-7 text-ink-soft">
                Une expérience pensée pour vous accompagner dans vos choix
                et vous permettre de faire votre shopping en toute simplicité.
            </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

            {# Valeur 1 #}
            <article class="rounded-2xl border border-beige bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-beige text-2xl">
                    ✨
                </div>

                <h3 class="mt-6 text-xl font-bold text-ink">
                    Style et élégance
                </h3>

                <p class="mt-3 leading-7 text-ink-soft">
                    Découvrez une sélection de vêtements, chaussures
                    et accessoires pour exprimer votre personnalité.
                </p>
            </article>

            {# Valeur 2 #}
            <article class="rounded-2xl border border-beige bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-beige text-2xl">
                    🛍️
                </div>

                <h3 class="mt-6 text-xl font-bold text-ink">
                    Shopping simplifié
                </h3>

                <p class="mt-3 leading-7 text-ink-soft">
                    Parcourez nos catégories et consultez les détails
                    des articles pour trouver ce qui vous convient.
                </p>
            </article>

            {# Valeur 3 #}
            <article class="rounded-2xl border border-beige bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md sm:col-span-2 lg:col-span-1">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-beige text-2xl">
                    ♡
                </div>

                <h3 class="mt-6 text-xl font-bold text-ink">
                    Une expérience agréable
                </h3>

                <p class="mt-3 leading-7 text-ink-soft">
                    Nous souhaitons rendre votre découverte de la mode
                    agréable, claire et accessible.
                </p>
            </article>

        </div>
    </div>
</section>


{# ==========================================================
   SECTION 4 : NOTRE MISSION
   ========================================================== #}
<section class="bg-white px-5 py-16 sm:px-8 md:py-24">
    <div class="container-page grid items-center gap-12 lg:grid-cols-2 lg:gap-16">

        {# Bloc principal #}
        <div class="rounded-3xl bg-cream p-8 sm:p-12">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                Notre mission
            </p>

            <h2 class="mt-4 text-3xl font-bold leading-tight text-ink sm:text-4xl">
                Vous aider à affirmer votre style.
            </h2>

            <p class="mt-6 leading-8 text-ink-soft">
                Nous croyons que la mode est une manière de se sentir bien
                et de montrer qui l'on est. C'est pourquoi ModeBoutique
                veut vous proposer un espace où vous pouvez découvrir
                différentes inspirations et choisir selon vos préférences.
            </p>

            <div class="mt-8">
                <twig:Button
                    variant="primary"
                    size="md"
                    href="{{ path('app_shop') }}"
                >
                    Explorer la boutique →
                </twig:Button>
            </div>
        </div>

        {# Raisons de choisir ModeBoutique #}
        <div>
            <h3 class="text-2xl font-bold text-ink">
                Pourquoi choisir ModeBoutique ?
            </h3>

            <div class="mt-8 space-y-6">

                <div class="flex gap-4">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-beige font-bold text-ink">
                        1
                    </div>

                    <div>
                        <h4 class="font-semibold text-ink">
                            Des catégories variées
                        </h4>
                        <p class="mt-2 leading-7 text-ink-soft">
                            Retrouvez des articles pour différents styles
                            et différentes occasions.
                        </p>
                    </div>
                </div>

                <div class="flex gap-4">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-beige font-bold text-ink">
                        2
                    </div>

                    <div>
                        <h4 class="font-semibold text-ink">
                            Des informations claires
                        </h4>
                        <p class="mt-2 leading-7 text-ink-soft">
                            Consultez les photos, les prix et les options
                            disponibles sur les fiches produits.
                        </p>
                    </div>
                </div>

                <div class="flex gap-4">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-beige font-bold text-ink">
                        3
                    </div>

                    <div>
                        <h4 class="font-semibold text-ink">
                            Une boutique accessible en ligne
                        </h4>
                        <p class="mt-2 leading-7 text-ink-soft">
                            Découvrez nos produits depuis votre ordinateur
                            ou votre téléphone.
                        </p>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>


{# ==========================================================
   SECTION 5 : APPEL À L'ACTION
   ========================================================== #}
<section class="bg-ink px-5 py-16 sm:px-8 md:py-20">
    <div class="mx-auto max-w-4xl text-center">

        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
            Prêt(e) à découvrir notre univers ?
        </p>

        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">
            Trouvez les pièces qui vous ressemblent.
        </h2>

        <p class="mx-auto mt-5 max-w-2xl leading-7 text-stone-300">
            Explorez notre boutique et laissez-vous inspirer par
            notre sélection de vêtements, chaussures et accessoires.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <twig:Button
                variant="secondary"
                size="md"
                href="{{ path('app_shop') }}"
            >
                Visiter la boutique
            </twig:Button>

            <twig:Button
                variant="outline"
                size="md"
                href="{{ path('app_contact') }}"
            >
                Nous écrire
            </twig:Button>
        </div>

    </div>
</section>

{% endblock %}
