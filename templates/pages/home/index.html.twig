{% extends 'layouts/base.html.twig' %}

{% block title %}Accueil — ModeBoutique{% endblock %}

{% block meta_description %}
    Découvrez ModeBoutique : vêtements, chaussures et accessoires élégants pour femme et homme.
{% endblock %}

{% block body %}

    {# ============================================================
   1. HERO — Présentation principale
   ============================================================ #}
    <section class="relative overflow-hidden bg-cream">
        <div class="container-page grid items-center gap-10 py-16 lg:grid-cols-2 lg:gap-16 lg:py-24">

            <div class="fade-in-up max-w-xl">
                <span class="inline-block rounded-full bg-brand-light px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-brand">
                    Nouvelle collection
                </span>

                <h1 class="mt-6 font-serif text-4xl font-semibold leading-tight text-ink sm:text-5xl lg:text-6xl">
                    L'élégance
                    <span class="text-brand">au quotidien</span>
                </h1>

                <p class="mt-6 text-base leading-relaxed text-ink-soft sm:text-lg">
                    Découvrez nos vêtements, chaussures et accessoires pour femme et homme.
                    Des pièces soigneusement sélectionnées pour compléter votre style au quotidien.
                </p>

                <div class="fade-in-up fade-in-up-delay-1 mt-10 flex flex-wrap items-center gap-4">
                    <twig:Button variant="primary" size="lg" href="{{ path('app_category') }}">
                        Explorer les catégories
                    </twig:Button>

                    <twig:Button variant="outline" size="lg" href="#nouveautes">
                        Voir les nouveautés
                    </twig:Button>
                </div>

                {# Indicateurs de confiance — contenu de démonstration #}
                <dl class="fade-in-up fade-in-up-delay-2 mt-12 grid grid-cols-3 gap-4 border-t border-stone-200/80 pt-8 sm:gap-6">
                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
                            Livraison
                        </dt>
                        <dd class="mt-1 font-serif text-lg font-semibold text-ink sm:text-xl">
                            Offerte*
                        </dd>
                    </div>

                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
                            Retours
                        </dt>
                        <dd class="mt-1 font-serif text-lg font-semibold text-ink sm:text-xl">
                            7 jours*
                        </dd>
                    </div>

                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
                            Paiement
                        </dt>
                        <dd class="mt-1 font-serif text-lg font-semibold text-ink sm:text-xl">
                            Sécurisé*
                        </dd>
                    </div>
                </dl>
            </div>

            <div class="fade-in-up fade-in-up-delay-1 relative">
                <div class="relative aspect-[4/5] overflow-hidden rounded-3xl shadow-xl">
                    <img
                        src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1200&q=80"
                        alt="Sélection de mode et de vêtements"
                        class="h-full w-full object-cover"
                        loading="eager"
                    >
                </div>

                <div class="absolute -bottom-6 -left-4 hidden rounded-2xl bg-white p-4 shadow-lg sm:block lg:-left-6">
                    <p class="font-serif text-2xl font-semibold text-ink">
                        Style
                    </p>
                    <p class="text-xs uppercase tracking-wider text-ink-soft">
                        Pour chaque occasion
                    </p>
                </div>
            </div>

        </div>
    </section>


    {# ============================================================
   2. CATÉGORIES — Femme et Homme
   ============================================================ #}
    <section id="categories" class="py-16 sm:py-20 lg:py-24">
        <div class="container-page">

            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                    Nos univers
                </p>

                <h2 class="mt-3 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                    Explorez nos catégories
                </h2>

                <p class="mt-4 text-base leading-relaxed text-ink-soft">
                    Découvrez nos collections pour femme et homme :
                    vêtements, chaussures et accessoires pour chaque style.
                </p>
            </div>

            <div class="mt-12 grid gap-6 sm:grid-cols-2">

                {% for category in categories %}
                    <twig:CategoryCard
                        name="{{ category.name }}"
                        description="{{ category.description ?? '' }}"
                        image="{{ category.image
                ? asset('uploads/categories/' ~ category.image)
                : asset('images/products/sac-beige.jpg') }}"
                        url="{{ path('app_category') }}#{{ category.slug }}"
                    />
                {% endfor %}

            </div>

            <div class="mt-8 text-center">
                <twig:Button
                    variant="outline"
                    size="md"
                    href="{{ path('app_category') }}"
                >
                    Explorer toutes les catégories
                </twig:Button>
            </div>

        </div>
    </section>


    {# ============================================================
   3. PRODUITS POPULAIRES — Les produits les plus vendus
   ============================================================ #}
    <section id="produits-populaires" class="bg-cream py-16 sm:py-20 lg:py-24">
        <div class="container-page">

            <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
                <div class="max-w-xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                        Coups de cœur
                    </p>

                    <h2 class="mt-3 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                        Nos produits populaires
                    </h2>

                    <p class="mt-4 text-base leading-relaxed text-ink-soft">
                        Découvrez une sélection de pièces qui pourraient vous plaire.
                    </p>
                </div>

                <twig:Button
                    variant="outline"
                    size="md"
                    href="{{ path('app_shop') }}"
                >
                    Voir tous les produits
                </twig:Button>
            </div>

            <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

                {% for product in featuredProducts %}

                    {% set productImage = featuredProductImages[product.id]|default(product.mainImage) %}

                    {% if productImage %}
                        {% if productImage starts with 'http://' or productImage starts with 'https://' %}
                            {% set imageUrl = productImage %}
                        {% elseif productImage starts with '/' %}
                            {% set imageUrl = productImage %}
                        {% elseif productImage starts with 'images/' or productImage starts with 'uploads/' %}
                            {% set imageUrl = asset(productImage) %}
                        {% else %}
                            {% set imageUrl = asset('images/products/' ~ productImage) %}
                        {% endif %}
                    {% else %}
                        {% set imageUrl = asset('images/products/sac-beige.jpg') %}
                    {% endif %}

                    <twig:ProductCard
                        productId="{{ product.id }}"
                        name="{{ product.name }}"
                        category="{{ product.category ? product.category.name : 'Sans catégorie' }}"
                        price="{{ productPricing[product.id].price|number_format(0, ',', ' ') ~ ' Ar' }}"
                        oldPrice="{{ productPricing[product.id].oldPrice is not null ? (productPricing[product.id].oldPrice|number_format(0, ',', ' ') ~ ' Ar') : '' }}"
                        discountBadge="{{ productPricing[product.id].discountBadge|default('') }}"
                        badge="{{ productPricing[product.id].hasPromotion ? 'Promotion' : 'Populaire' }}"
                        image="{{ imageUrl }}"
                        href="{{ path('app_product_detail', {slug: product.slug}) }}"
                    />

                {% else %}

                    <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:col-span-2 lg:col-span-4">
                        <p class="text-sm text-ink-soft">
                            Aucun produit n'est actuellement mis en vedette.
                        </p>
                    </div>

                {% endfor %}

            </div>

        </div>
    </section>


    {# ============================================================
   4. NOUVEAUTÉS — Données fictives
   ============================================================ #}
    <section id="nouveautes" class="py-16 sm:py-20 lg:py-24">
        <div class="container-page">

            <div class="max-w-2xl">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                    Tout juste arrivé
                </p>

                <h2 class="mt-3 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                    Les nouveautés
                </h2>

                <p class="mt-4 text-base leading-relaxed text-ink-soft">
                    Découvrez les dernières pièces présentées dans notre boutique.
                </p>
            </div>

            <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

                {% for product in latestProducts %}

                    {# Récupérer le chemin correct de l'image principale. #}
                    {% if product.mainImage %}
                        {% if product.mainImage starts with 'http://' or product.mainImage starts with 'https://' %}
                            {% set imageUrl = product.mainImage %}
                        {% elseif product.mainImage starts with '/' %}
                            {% set imageUrl = product.mainImage %}
                        {% elseif product.mainImage starts with 'images/' or product.mainImage starts with 'uploads/' %}
                            {% set imageUrl = asset(product.mainImage) %}
                        {% else %}
                            {% set imageUrl = asset('images/products/' ~ product.mainImage) %}
                        {% endif %}
                    {% else %}
                        {% set imageUrl = asset('images/products/sac-beige.jpg') %}
                    {% endif %}

                    <twig:ProductCard
                        productId="{{ product.id }}"
                        name="{{ product.name }}"
                        category="{{ product.category ? product.category.name : 'Sans catégorie' }}"
                        price="{{ productPricing[product.id].price|number_format(0, ',', ' ') ~ ' Ar' }}"
                        oldPrice="{{ productPricing[product.id].oldPrice is not null ? (productPricing[product.id].oldPrice|number_format(0, ',', ' ') ~ ' Ar') : '' }}"
                        discountBadge="{{ productPricing[product.id].discountBadge|default('') }}"
                        badge="{{ productPricing[product.id].hasPromotion ? 'Promotion' : 'Nouveau' }}"
                        image="{{ imageUrl }}"
                        href="{{ path('app_product_detail', {slug: product.slug}) }}"
                    />

                {% else %}

                    <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:col-span-2 lg:col-span-4">
                        <p class="text-sm text-ink-soft">
                            Aucun produit publié n'est disponible pour le moment.
                        </p>
                    </div>

                {% endfor %}

            </div>

        </div>
    </section>


    {# ============================================================
   5. BANNIÈRE PROMOTIONNELLE
   ============================================================ #}
    <section id="promotions" class="pb-16 sm:pb-20 lg:pb-24">
        <div class="container-page">

            <div class="relative overflow-hidden rounded-3xl bg-brand px-6 py-14 text-center text-white sm:px-12 sm:py-20">

                <div class="pointer-events-none absolute -left-20 -top-20 h-64 w-64 rounded-full bg-white/10"></div>
                <div class="pointer-events-none absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-white/10"></div>

                <div class="relative mx-auto max-w-2xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-light">
                        Sélection promotionnelle
                    </p>

                    <h2 class="mt-4 font-serif text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">
                        Découvrez nos offres
                    </h2>

                    <p class="mt-4 text-base leading-relaxed text-white/85 sm:text-lg">
                        Explorez une sélection de vêtements, chaussures et accessoires
                        mis en avant dans notre boutique.
                    </p>

                    <p class="mt-3 text-xs text-white/75">
                        Les réductions affichées seront confirmées lorsque le catalogue sera connecté.
                    </p>

                    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
                        <twig:Button
                            variant="light"
                            size="lg"
                            href="{{ path('app_promotions') }}"
                        >
                            Découvrir les promotions
                        </twig:Button>

                        <twig:Button
                            variant="outline"
                            size="lg"
                            href="{{ path('app_category') }}"
                        >
                            Voir les catégories
                        </twig:Button>
                    </div>
                </div>

            </div>
        </div>
    </section>


    {# ============================================================
   6. POURQUOI CHOISIR MODEBOUTIQUE ?
   ============================================================ #}
    <section class="bg-cream py-16 sm:py-20 lg:py-24">
        <div class="container-page">

            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                    Notre engagement
                </p>

                <h2 class="mt-3 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                    Pourquoi choisir ModeBoutique ?
                </h2>

                <p class="mt-4 text-base leading-relaxed text-ink-soft">
                    Une expérience d'achat conçue pour faciliter votre découverte de la mode.
                </p>
            </div>

            <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

                <a
                    href="{{ path('app_delivery_info') }}"
                    class="block rounded-2xl bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
                >
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-light text-brand">
                        {{ ux_icon('lucide:truck', {class: 'h-6 w-6'}) }}
                    </div>

                    <h3 class="mt-5 text-lg font-semibold text-ink">
                        Livraison
                    </h3>

                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                        Consultez les conditions de livraison proposées par la boutique.
                    </p>
                </a>

                <a
                    href="{{ path('app_return_info') }}"
                    class="block rounded-2xl bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
                >
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-light text-brand">
                        {{ ux_icon('lucide:refresh-ccw', {class: 'h-6 w-6'}) }}
                    </div>

                    <h3 class="mt-5 text-lg font-semibold text-ink">
                        Politique de retour
                    </h3>

                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                        Retrouvez les informations concernant les retours et les échanges.
                    </p>
                </a>

                <a
                    href="{{ path('app_payment_info') }}"
                    class="block rounded-2xl bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
                >
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-light text-brand">
                        {{ ux_icon('lucide:shield-check', {class: 'h-6 w-6'}) }}
                    </div>

                    <h3 class="mt-5 text-lg font-semibold text-ink">
                        Paiement
                    </h3>

                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                        Découvrez les moyens de paiement et les modalités de règlement.
                    </p>
                </a>

                <a
                    href="{{ path('app_contact') }}"
                    class="block rounded-2xl bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
                >
                    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-light text-brand">
                        {{ ux_icon('lucide:headset', {class: 'h-6 w-6'}) }}
                    </div>

                    <h3 class="mt-5 text-lg font-semibold text-ink">
                        Service client
                    </h3>

                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                        Contactez notre équipe pour toute question concernant votre commande.
                    </p>
                </a>

            </div>

        </div>
    </section>


    {# ============================================================
   7. NEWSLETTER — Maquette visuelle
   ============================================================ #}
    <section class="py-16 sm:py-20 lg:py-24">
        <div class="container-page">

            <div class="mx-auto max-w-3xl rounded-3xl border border-stone-200/80 bg-white p-8 text-center shadow-sm sm:p-12">

                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                    Restons en contact
                </p>

                <h2 class="mt-3 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                    Recevez nos nouveautés
                </h2>

                <p class="mt-4 text-base leading-relaxed text-ink-soft">
                    Retrouvez les nouvelles collections et les actualités de ModeBoutique.
                </p>

                {# Formulaire d'inscription à la newsletter #}
                <form action="{{ path('app_newsletter') }}" method="post" class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row">
                    
                    <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">

                    <label for="newsletter-email" class="sr-only">
                        Votre adresse e-mail
                    </label>

                    <input
                        <input
                        id="newsletter-email"
                        type="text"
                        name="email"
                        required
                        placeholder="votre@email.com"
                        class="w-full rounded-full border border-stone-300 bg-cream px-5 py-3 text-sm text-ink placeholder:text-ink-soft/70 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
                    >

                    <twig:Button variant="primary" size="md" type="submit">
                        S'inscrire
                    </twig:Button>
                </form>

                {# Messages de confirmation et d'erreur #}
                {% for message in app.flashes('success') %}
                    <p class="mt-4 text-sm font-medium text-green-700">
                        {{ message }}
                    </p>
                {% endfor %}

                {% for message in app.flashes('info') %}
                    <p class="mt-4 text-sm font-medium text-[#9A704B]">
                        {{ message }}
                    </p>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <p class="mt-4 text-sm font-medium text-red-600">
                        {{ message }}
                    </p>
                {% endfor %}

            </div>
        </div>
    </section>


    {# ============================================================
   8. INSCRIPTION / CONNEXION — Maquette visuelle
   ============================================================ #}
    <section class="px-5 pb-16 sm:pb-20">
        <div class="container-page">

            <div class="relative overflow-hidden rounded-3xl border border-brand/15 bg-[#FDF8FA] px-6 py-10 text-center sm:px-12 sm:py-14">

                <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full bg-brand/10"></div>
                <div class="pointer-events-none absolute -bottom-16 -left-12 h-48 w-48 rounded-full bg-brand/10"></div>

                <div class="relative mx-auto max-w-2xl">
                    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                        Rejoignez-nous
                    </p>

                    <h2 class="mt-3 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                        Bienvenue chez ModeBoutique
                    </h2>

                    <p class="mx-auto mt-4 max-w-xl text-base leading-7 text-ink-soft">
                        Créez votre compte pour retrouver vos favoris et profiter
                        d'une expérience shopping personnalisée.
                    </p>

                    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
                        <twig:Button
                            variant="primary"
                            size="lg"
                            href="{{ path('app_register') }}"
                        >
                            Créer un compte
                        </twig:Button>

                        <twig:Button
                            variant="outline"
                            size="lg"
                            href="{{ path('app_login') }}"
                        >
                            Se connecter
                        </twig:Button>
                    </div>
                </div>

            </div>
        </div>
    </section>

{% endblock %}
