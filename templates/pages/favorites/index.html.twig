{% extends 'layouts/base.html.twig' %}

{% block title %}Mes favoris | ModeBoutique{% endblock %}

{% block body %}

{# En-tête de la page #}
<section class="bg-[#F5F0E8] px-4 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl">
        <p class="mb-3 text-sm font-medium uppercase tracking-[0.2em] text-[#B08D67]">
            ModeBoutique
        </p>

        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
            <div>
                <h1 class="text-3xl font-bold text-[#292524] sm:text-4xl">
                    Mes favoris
                </h1>

                <p class="mt-3 max-w-xl text-sm leading-6 text-[#44403C] sm:text-base">
                    Retrouvez les articles que vous aimez et gardez-les
                    à portée de main pour votre prochain achat.
                </p>
            </div>

            <a href="{{ path('app_shop') }}"
               class="inline-flex w-fit items-center justify-center rounded-xl bg-[#292524] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#44403C]">
                Continuer mes achats
                <span class="ml-2" aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>

{# Liste des produits favoris #}
<section class="bg-white px-4 py-10 sm:py-14">
    <div class="mx-auto max-w-7xl">

        {# Messages de confirmation #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 rounded-xl border border-green-200 bg-green-50 px-5 py-3 text-sm text-green-800">
                {{ message }}
            </div>
        {% endfor %}

        <div class="mb-8 flex items-center justify-between gap-4">
            <h2 class="text-lg font-bold text-[#292524] sm:text-xl">
                Vos articles préférés
            </h2>

            <span class="rounded-full bg-[#F5F0E8] px-4 py-2 text-sm font-semibold text-[#B08D67]">
                {{ favoritesCount }}
                {{ favoritesCount > 1 ? 'articles' : 'article' }}
            </span>
        </div>

        {# Afficher un message lorsque la liste est vide #}
        {% if favorites is empty %}

            <div class="rounded-3xl border border-[#E7DED2] bg-[#F5F0E8] px-6 py-12 text-center">
                <div class="mb-4 text-5xl" aria-hidden="true">♡</div>

                <h3 class="text-xl font-bold text-[#292524]">
                    Votre liste de favoris est vide
                </h3>

                <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-[#78716C]">
                    Ajoutez les articles qui vous plaisent pour les retrouver
                    facilement ici.
                </p>

                <a href="{{ path('app_shop') }}"
                   class="mt-6 inline-flex rounded-xl bg-[#292524] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#44403C]">
                    Découvrir la boutique
                </a>
            </div>

        {% else %}

            {# Afficher les favoris enregistrés en base de données #}
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">

                {% for favorite in favorites %}

                    {% set product = favorite.product %}

                    {# Récupérer le chemin correct de l'image principale #}
                    {% if product.mainImage %}
                        {% if product.mainImage starts with 'http://' or product.mainImage starts with 'https://' %}
                            {% set imageUrl = product.mainImage %}
                        {% elseif product.mainImage starts with '/' %}
                            {% set imageUrl = product.mainImage %}
                        {% elseif product.mainImage starts with 'images/' or product.mainImage starts with 'uploads/' %}
                            {% set imageUrl = asset(product.mainImage) %}
                        {% else %}
                            {% set imageUrl = asset('images/products/' ~ product.mainImage) %}
                        {% endif %}
                    {% else %}
                        {% set imageUrl = asset('images/products/sac-beige.jpg') %}
                    {% endif %}

                    <article class="group overflow-hidden rounded-2xl border border-[#E7DED2] bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg">

                        <div class="relative overflow-hidden bg-[#F5F0E8]">

                            <a href="{{ path('app_product_detail', {slug: product.slug}) }}">
                                <img src="{{ imageUrl }}"
                                     alt="{{ product.name }}"
                                     loading="lazy"
                                     class="h-72 w-full object-cover transition duration-500 group-hover:scale-105">
                            </a>

                            <span class="absolute left-4 top-4 rounded-full bg-[#B08D67] px-3 py-1.5 text-xs font-semibold text-white">
                                Coup de cœur
                            </span>

                            {# Formulaire de suppression du favori #}
                            <form
                                method="post"
                                action="{{ path('app_favorite_remove', {id: favorite.id}) }}"
                                class="absolute right-4 top-4"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('favorite_remove_' ~ favorite.id) }}"
                                >

                                <button
                                    type="submit"
                                    aria-label="Retirer {{ product.name }} des favoris"
                                    title="Retirer des favoris"
                                    class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-red-500 shadow-sm transition hover:bg-red-50"
                                >
                                    {{ ux_icon('lucide:trash-2', {class: 'h-5 w-5'}) }}
                                </button>
                            </form>
                        </div>

                        <div class="p-5">
                            <p class="text-xs font-medium uppercase tracking-wider text-[#B08D67]">
                                {{ product.category ? product.category.name : 'Sans catégorie' }}
                            </p>

                            <a href="{{ path('app_product_detail', {slug: product.slug}) }}"
                               class="mt-2 block text-lg font-semibold text-[#292524] transition hover:text-[#B08D67]">
                                {{ product.name }}
                            </a>

                            <div class="mt-3 flex items-center gap-3">
                                <span class="text-lg font-bold text-[#292524]">
                                    {{ product.price|number_format(0, ',', ' ') }} Ar
                                </span>

                                {% if product.oldPrice is not null %}
                                    <span class="text-sm text-[#A8A29E] line-through">
                                        {{ product.oldPrice|number_format(0, ',', ' ') }} Ar
                                    </span>
                                {% endif %}
                            </div>

                            <a href="{{ path('app_product_detail', {slug: product.slug}) }}"
                               class="mt-5 flex w-full items-center justify-center rounded-xl bg-[#292524] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#B08D67]">
                                Voir le produit
                            </a>
                        </div>
                    </article>

                {% endfor %}

            </div>

        {% endif %}

    </div>
</section>

{% endblock %}
