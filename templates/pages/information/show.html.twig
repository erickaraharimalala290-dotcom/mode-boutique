{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }} | ModeBoutique{% endblock %}

{% block body %}

<section class="bg-cream py-16 sm:py-20 lg:py-24">
    <div class="container-page">

        <div class="mx-auto max-w-3xl text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">
                Informations pratiques
            </p>

            <h1 class="mt-4 font-serif text-3xl font-semibold text-ink sm:text-4xl">
                {{ title }}
            </h1>

            <p class="mt-5 text-base leading-8 text-ink-soft">
                {{ intro }}
            </p>
        </div>

        <div class="mx-auto mt-12 max-w-3xl space-y-5">

            {% for section in sections %}
                <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">

                    <h2 class="text-xl font-semibold text-ink">
                        {{ section.title }}
                    </h2>

                    <p class="mt-3 text-sm leading-7 text-ink-soft">
                        {{ section.text }}
                    </p>

                </article>
            {% endfor %}

        </div>

        <div class="mt-10 text-center">
            <p class="text-sm text-ink-soft">
                Vous avez besoin d'informations complémentaires ?
            </p>

            <a href="{{ path('app_contact') }}"
               class="mt-4 inline-flex rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90">
                Contacter notre service client
            </a>

            <div class="mt-5">
                <a href="{{ path('home') }}"
                   class="text-sm font-medium text-brand transition hover:underline">
                    Retour à l'accueil
                </a>
            </div>
        </div>

    </div>
</section>

{% endblock %}
