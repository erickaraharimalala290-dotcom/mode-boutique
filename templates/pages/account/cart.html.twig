{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Mon panier | Mon espace - ModeBoutique{% endblock %}

{% block body %}
    <section class="min-h-screen bg-cream px-4 py-8 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">

            {# En-tête de l'espace client #}
            <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <a href="{{ path('home') }}" class="text-2xl font-bold text-ink">
                        Mode<span class="text-brand">Boutique</span>
                    </a>

                    <p class="mt-1 text-sm text-ink-soft">
                        Mon espace client / Mon panier
                    </p>
                </div>

                <a
                    href="{{ path('app_account') }}"
                    class="rounded-full border border-beige bg-white px-5 py-3 text-sm font-semibold text-ink hover:border-brand hover:text-brand"
                >
                    ← Retour au Tableau de bord
                </a>
            </header>

            {# Messages de confirmation et d'erreur #}
            {% for message in app.flashes('success') %}
                <div class="mb-5 rounded-xl border border-green-200 bg-green-50 px-5 py-4 text-sm text-green-800">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-800">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">

                {# Sidebar de l'espace client #}
                {% include 'pages/account/_sidebar.html.twig' with {
                activePage: 'cart'
            } %}

                <main class="min-w-0 space-y-6">

                    {# Présentation du panier #}
                    <section class="rounded-3xl border border-beige bg-gradient-to-br from-[#FBF7F1] to-[#E8DCCB] p-7 sm:p-9">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-dark">
                            Votre sélection
                        </p>

                        <h1 class="mt-3 text-3xl font-bold text-ink">
                            Mon panier
                        </h1>

                        <p class="mt-3 max-w-xl text-sm leading-7 text-ink-soft">
                            Retrouvez vos articles et préparez votre prochaine
                            commande en toute simplicité.
                        </p>
                    </section>

                    {% if items is empty %}

                        {# Panier vide #}
                        <section class="rounded-3xl border border-beige bg-white px-6 py-12 text-center shadow-sm">
                            <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-cream text-4xl text-brand">
                                ♡
                            </div>

                            <h2 class="mt-5 text-2xl font-bold text-ink">
                                Votre panier est vide
                            </h2>

                            <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-ink-soft">
                                Vous n'avez pas encore ajouté d'articles à votre panier.
                                Découvrez notre collection et trouvez votre prochain coup de cœur.
                            </p>

                            <a
                                href="{{ path('app_shop') }}"
                                class="mt-6 inline-flex items-center justify-center rounded-full bg-ink px-6 py-3 font-semibold text-white transition hover:bg-stone-700"
                            >
                                Découvrir la boutique
                            </a>
                        </section>

                    {% else %}

                        {# Contenu du panier #}
                        <div class="grid items-start gap-6">

                            {# Liste des articles #}
                            <section class="min-w-0 rounded-3xl border border-beige bg-white p-5 shadow-sm sm:p-7">

                                <div class="mb-6 flex items-center justify-between gap-3 border-b border-beige pb-4">
                                    <h2 class="text-xl font-bold text-ink">
                                        Vos articles
                                    </h2>

                                    <span class="text-sm text-ink-soft">
                                        {{ cartCount }} article{{ cartCount > 1 ? 's' : '' }}
                                    </span>
                                </div>

                                <div class="space-y-5">

                                    {% for item in items %}

                                        {% set product = item.product %}
                                        {% set variant = item.variant %}
                                        {% set matchingImages = [] %}

                                        {# Rechercher l'image correspondant à la couleur #}
                                        {% if variant and variant.color %}
                                            {% set matchingImages = product.images|filter(image =>
                                            image.color and image.color|lower == variant.color|lower
                                        ) %}
                                        {% endif %}

                                        {% set variantImage = matchingImages|first %}

                                        <article class="flex flex-col gap-4 border-b border-beige pb-5 sm:flex-row sm:gap-5">

                                            {# Image du produit #}
                                            <a
                                                href="{{ path('app_product_detail', {slug: product.slug}) }}"
                                                class="h-28 w-24 shrink-0 overflow-hidden rounded-xl bg-cream sm:h-36 sm:w-28"
                                            >

                                                {% if variantImage %}
                                                    <img
                                                        src="{{ asset(variantImage.imagePath) }}"
                                                        alt="{{ variantImage.altText|default(product.name) }}"
                                                        class="h-full w-full object-cover transition duration-300 hover:scale-105"
                                                    >
                                                {% elseif product.mainImage %}
                                                    <img
                                                        src="{{ asset(product.mainImage) }}"
                                                        alt="{{ product.name }}"
                                                        class="h-full w-full object-cover transition duration-300 hover:scale-105"
                                                    >
                                                {% else %}
                                                    <div class="flex h-full items-center justify-center text-xs text-ink-soft">
                                                        Image indisponible
                                                    </div>
                                                {% endif %}
                                            </a>

                                            <div class="flex min-w-0 flex-1 flex-col justify-between gap-3">

                                                <div>
                                                    <div class="flex items-start justify-between gap-2">
                                                        <div>
                                                            <p class="text-xs uppercase tracking-wider text-brand">
                                                                {{ product.category.name }}
                                                            </p>

                                                            <h3 class="mt-2 font-semibold text-ink">
                                                                {{ product.name }}
                                                            </h3>
                                                        </div>

                                                        {# Supprimer l'article #}
                                                        <form
                                                            method="post"
                                                            action="{{ path('app_cart_remove', {id: item.id}) }}"
                                                        >
                                                            <input
                                                                type="hidden"
                                                                name="_token"
                                                                value="{{ csrf_token('cart_remove_' ~ item.id) }}"
                                                            >

                                                            <input type="hidden" name="return_to" value="account">

                                                            <button
                                                                type="submit"
                                                                class="shrink-0 text-xl text-ink-soft transition hover:text-red-700"
                                                                aria-label="Supprimer {{ product.name }}"
                                                            >
                                                                ×
                                                            </button>
                                                        </form>
                                                    </div>

                                                    {% if variant and variant.color %}
                                                        <p class="mt-2 text-sm text-ink-soft">
                                                            Couleur : {{ variant.color }}
                                                        </p>
                                                    {% endif %}

                                                    {% if variant and variant.size %}
                                                        <p class="mt-1 text-sm text-ink-soft">
                                                            Taille / Pointure : {{ variant.size }}
                                                        </p>
                                                    {% endif %}

                                                    <p class="mt-2 text-sm text-ink-soft">
                                                        Prix unitaire :
                                                        <span class="font-medium text-ink">
                                                            {{ item.unitPrice|number_format(0, ',', ' ') }} Ar
                                                        </span>
                                                    </p>
                                                </div>

                                                {# Quantité et total de l'article #}
                                                <div class="flex flex-wrap items-end justify-between gap-3">

                                                    <form
                                                        method="post"
                                                        action="{{ path('app_cart_update_quantity', {id: item.id}) }}"
                                                        class="flex flex-wrap items-end gap-3"
                                                    >

                                                        <input
                                                            type="hidden"
                                                            name="_token"
                                                            value="{{ csrf_token('cart_update_' ~ item.id) }}"
                                                        >

                                                        <input type="hidden" name="return_to" value="account">

                                                        <div>
                                                            <label
                                                                for="account-quantity-{{ item.id }}"
                                                                class="mb-2 block text-xs font-semibold text-ink"
                                                            >
                                                                Quantité
                                                            </label>

                                                            <input
                                                                id="account-quantity-{{ item.id }}"
                                                                type="number"
                                                                name="quantity"
                                                                min="1"
                                                                {% if variant %}
                                                                max="{{ variant.stockQuantity }}"
                                                                {% endif %}
                                                                value="{{ item.quantity }}"
                                                                required
                                                                class="w-20 rounded-lg border border-beige bg-white px-3 py-2 text-center text-sm text-ink outline-none focus:border-brand focus:ring-2 focus:ring-beige"
                                                            >
                                                        </div>

                                                        <button
                                                            type="submit"
                                                            class="rounded-lg border border-beige px-3 py-2 text-xs font-semibold text-ink transition hover:bg-cream"
                                                        >
                                                            Mettre à jour
                                                        </button>
                                                    </form>

                                                    <p class="font-bold text-ink">
                                                        {{ (item.unitPrice * item.quantity)|number_format(0, ',', ' ') }} Ar
                                                    </p>
                                                </div>

                                            </div>
                                        </article>

                                    {% endfor %}

                                </div>

                                <a
                                    href="{{ path('app_shop') }}"
                                    class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-ink transition hover:text-brand"
                                >
                                    <span aria-hidden="true">←</span>
                                    Continuer mes achats
                                </a>
                            </section>

                            {# Résumé de la commande #}
                            <aside class="rounded-3xl border border-beige bg-white p-6 shadow-sm sm:p-7">

                                <h2 class="text-xl font-bold text-ink">
                                    Résumé de la commande
                                </h2>

                                <div class="mt-6 space-y-4">

                                    <div class="flex items-center justify-between gap-4 text-sm">
                                        <span class="text-ink-soft">
                                            Nombre d'articles
                                        </span>

                                        <span class="font-semibold text-ink">
                                            {{ cartCount }}
                                        </span>
                                    </div>

                                    <div class="flex items-center justify-between gap-4 text-sm">
                                        <span class="text-ink-soft">
                                            Sous-total
                                        </span>

                                        <span class="font-semibold text-ink">
                                            {{ subtotal|number_format(0, ',', ' ') }} Ar
                                        </span>
                                    </div>

                                    <div class="flex items-center justify-between gap-4 text-sm">
                                        <span class="text-ink-soft">Livraison</span>
                                        <span class="text-right text-ink-soft">À confirmer</span>
                                    </div>

                                    <p class="text-xs leading-5 text-ink-soft">
                                        Les frais de livraison seront précisés avant la validation
                                        définitive de la commande.
                                    </p>

                                    <div class="border-t border-beige pt-4">
                                        <div class="flex items-center justify-between gap-4">
                                            <span class="font-semibold text-ink">
                                                Total provisoire
                                            </span>

                                            <span class="text-xl font-bold text-ink">
                                                {{ subtotal|number_format(0, ',', ' ') }} Ar
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <a
                                    href="{{ path('app_checkout') }}"
                                    class="mt-7 inline-flex w-full items-center justify-center rounded-full bg-brand px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                >
                                    Passer la commande →
                                </a>

                                <p class="mt-4 text-center text-xs leading-5 text-ink-soft">
                                    La validation et le paiement seront disponibles après
                                    la mise en place du système de commande.
                                </p>

                            </aside>

                        </div>

                    {% endif %}

                </main>
            </div>
        </div>
    </section>
{% endblock %}
