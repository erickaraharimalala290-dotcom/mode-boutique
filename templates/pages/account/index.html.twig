{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Mon espace client | ModeBoutique{% endblock %}

{% block body %}
    <section class="min-h-screen bg-cream px-4 py-8 sm:px-6 sm:py-8 lg:px-8">
        <div class="mx-auto max-w-7xl">

            {# En-tête #}
            <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <a href="{{ path('home') }}" class="text-2xl font-bold tracking-tight text-ink">
                        Mode<span class="text-brand">Boutique</span>
                    </a>
                    <p class="mt-1 text-sm text-ink-soft">Mon espace client</p>
                </div>

                <a
                    href="{{ path('app_shop') }}"
                    class="rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
                >
                    Continuer mes achats →
                </a>
            </header>

            <div class="grid gap-6 lg:grid-cols-[240px_minmax(0,1fr)]">

                {# Navigation commune #}
                {% include 'pages/account/_sidebar.html.twig' with {
                activePage: 'dashboard'
            } %}

                {# Contenu principal #}
                <main class="min-w-0 space-y-6">

                    {# Bannière de bienvenue #}
                    <section class="grid overflow-hidden rounded-3xl border border-beige bg-gradient-to-br from-[#FBF7F1] via-[#F5F0E8] to-[#E8DCCB] sm:grid-cols-[1fr_220px]">
                        <div class="p-7 sm:p-9">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-dark">
                                Votre espace personnel
                            </p>

                            <h1 class="mt-3 text-3xl font-bold leading-tight text-ink">
                                Bonjour
                                {% if app.user and app.user.firstName|default('') %}
                                    {{ app.user.firstName }} !
                                {% else %}
                                    et bienvenue !
                                {% endif %}
                            </h1>

                            <p class="mt-4 max-w-md text-sm leading-7 text-ink-soft">
                                Retrouvez vos commandes et gérez facilement
                                votre compte ModeBoutique.
                            </p>

                            <a
                                href="{{ path('app_account_profile') }}"
                                class="mt-6 inline-flex rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
                            >
                                Gérer mon profil
                            </a>
                        </div>

                        <div class="relative hidden min-h-[240px] p-4 sm:block">
                            <img
                                src="{{ asset('images/products/robe-soirée-marron.jpg') }}"
                                alt="Collection ModeBoutique"
                                class="h-full min-h-[240px] w-full rounded-2xl object-cover"
                            >
                        </div>
                    </section>

                
                    {# Cartes de synthèse dynamiques #}
                    <div class="grid gap-4 sm:grid-cols-3">
                        <article class="rounded-2xl border border-beige bg-white p-5 shadow-sm">
                            <p class="text-sm text-ink-soft">Mes commandes</p>
                            <p class="mt-3 text-3xl font-bold text-ink">
                                {{ totalOrders }}
                            </p>
                            <p class="mt-1 text-xs text-ink-soft">Commandes enregistrées</p>
                            <a
                                href="{{ path('app_account_orders') }}"
                                class="mt-3 inline-block text-sm font-semibold text-brand hover:underline"
                            >
                                Voir mes commandes →
                            </a>
                        </article>

                        <article class="rounded-2xl border border-beige bg-white p-5 shadow-sm">
                            <p class="text-sm text-ink-soft">Mes favoris</p>
                            <p class="mt-3 text-3xl font-bold text-ink">
                                {{ favoritesCount }}
                            </p>
                            <p class="mt-1 text-xs text-ink-soft">Articles favoris</p>
                            <a
                                href="{{ path('app_account_favorites') }}"
                                class="mt-3 inline-block text-sm font-semibold text-brand hover:underline"
                            >
                                Voir mes favoris →
                            </a>
                        </article>

                        <article class="rounded-2xl border border-beige bg-white p-5 shadow-sm">
                            <p class="text-sm text-ink-soft">Total des achats</p>
                            <p class="mt-3 text-2xl font-bold text-ink">
                                {{ totalPurchases|number_format(0, ',', ' ') }} Ar
                            </p>
                            <p class="mt-1 text-xs text-ink-soft">Montant réellement payé</p>
                        </article>
                    </div>


                    {# Dernières commandes #}
                    <section id="commandes" class="overflow-hidden rounded-3xl border border-beige bg-white shadow-sm">
                        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-beige p-5">
                            <div>
                                <h2 class="font-bold text-ink">Mes dernières commandes</h2>
                                <p class="mt-1 text-sm text-ink-soft">Aperçu de votre activité.</p>
                            </div>

                            {# <span class="rounded-full bg-cream px-3 py-1.5 text-xs text-ink-soft">
                                Démonstration
                            </span> #}
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[520px] text-left text-sm">
                                <thead class="bg-cream text-xs uppercase text-ink-soft">
                                    <tr>
                                        <th class="px-5 py-4 font-semibold">Commande</th>
                                        <th class="px-5 py-4 font-semibold">Date</th>
                                        <th class="px-5 py-4 font-semibold">Montant</th>
                                        <th class="px-5 py-4 font-semibold">Statut</th>
                                    </tr>
                                </thead>

                                
                                <tbody class="divide-y divide-beige text-ink">
                                    {% for order in latestOrders %}
                                        {% set status = order.status|lower %}

                                        {% set statusLabels = {
                                            pending: 'En attente',
                                            confirmed: 'Confirmée',
                                            processing: 'En préparation',
                                            shipped: 'Expédiée',
                                            delivered: 'Livrée',
                                            cancelled: 'Annulée'
                                        } %}

                                        {% set statusClasses = {
                                            pending: 'bg-amber-50 text-amber-800',
                                            confirmed: 'bg-blue-50 text-blue-700',
                                            processing: 'bg-orange-50 text-orange-700',
                                            shipped: 'bg-indigo-50 text-indigo-700',
                                            delivered: 'bg-green-50 text-green-700',
                                            cancelled: 'bg-red-50 text-red-700'
                                        } %}

                                        <tr>
                                            <td class="px-5 py-4 font-semibold">
                                                <a
                                                    href="{{ path('app_account_order_detail', {
                                                        orderNumber: order.orderNumber
                                                    }) }}"
                                                    class="hover:text-brand"
                                                >
                                                    #{{ order.orderNumber }}
                                                </a>
                                            </td>

                                            <td class="px-5 py-4 text-ink-soft">
                                                {{ order.createdAt|date('d/m/Y') }}
                                            </td>

                                            <td class="px-5 py-4">
                                                {{ order.totalAmount|number_format(0, ',', ' ') }} Ar
                                            </td>

                                            <td class="px-5 py-4">
                                                <span class="rounded-full px-3 py-1.5 text-xs {{ statusClasses[status]|default('bg-gray-100 text-gray-700') }}">
                                                    {{ statusLabels[status]|default(status|capitalize) }}
                                                </span>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="px-5 py-8 text-center text-sm text-ink-soft">
                                                Vous n'avez pas encore passé de commande.
                                                <a href="{{ path('app_shop') }}" class="font-semibold text-brand hover:underline">
                                                    Découvrir la boutique
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>

                            </table>
                        </div>

                        <div class="border-t border-beige p-5 text-right">
                            <a
                                href="{{ path('app_account_orders') }}"
                                class="text-sm font-semibold text-brand hover:text-brand-dark"
                            >
                                Consulter toutes mes commandes →
                            </a>
                        </div>
                    </section>

                </main>
            </div>
        </div>
    </section>
{% endblock %}
