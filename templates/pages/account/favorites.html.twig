{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Mes favoris | ModeBoutique{% endblock %}

{% block body %}
    <section class="min-h-screen bg-cream px-4 py-8 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">

            {# En-tête de l'espace client #}
            <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <a href="{{ path('home') }}" class="text-2xl font-bold text-ink">
                        Mode<span class="text-brand">Boutique</span>
                    </a>

                    <p class="mt-1 text-sm text-ink-soft">
                        Mon espace client / Mes favoris
                    </p>
                </div>

                <a
                    href="{{ path('app_account') }}"
                    class="rounded-full border border-beige bg-white px-5 py-3 text-sm font-semibold text-ink hover:border-brand hover:text-brand"
                >
                    ← Retour au Tableau de bord
                </a>
            </header>

            <div class="grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)]">

                {# Menu latéral du compte client #}
                {% include 'pages/account/_sidebar.html.twig' with {
                activePage: 'favorites'
            } %}

                <main class="min-w-0 space-y-6">

                    {# Présentation de la page #}
                    <section class="rounded-3xl border border-beige bg-gradient-to-br from-[#FBF7F1] to-[#E8DCCB] p-7 sm:p-9">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-dark">
                            Ma sélection
                        </p>

                        <h1 class="mt-3 text-3xl font-bold text-ink">
                            Mes favoris
                        </h1>

                        <p class="mt-3 max-w-xl text-sm leading-7 text-ink-soft">
                            Retrouvez ici les articles que vous aimez et gardez
                            vos pièces préférées à portée de main.
                        </p>
                    </section>

                    {# Liste des produits favoris #}
                    <section class="rounded-3xl border border-beige bg-white p-5 shadow-sm sm:p-7">

                        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                            <div>
                                <h2 class="text-xl font-bold text-ink">
                                    Votre liste d'envies
                                </h2>

                                <p class="mt-2 text-sm text-ink-soft">
                                    Les articles sélectionnés pour vous.
                                </p>
                            </div>

                            <span class="rounded-full bg-brand-light px-4 py-2 text-sm font-semibold text-brand">
                                {{ favoritesCount }}
                                {{ favoritesCount > 1 ? 'articles' : 'article' }}
                            </span>
                        </div>

                        {# Afficher un message si la liste est vide #}
                        {% if favorites is empty %}

                            <div class="rounded-2xl border border-beige bg-cream px-5 py-10 text-center">

                                <div class="text-5xl text-brand" aria-hidden="true">
                                    ♡
                                </div>

                                <h3 class="mt-4 text-lg font-bold text-ink">
                                    Votre liste de favoris est vide
                                </h3>

                                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-ink-soft">
                                    Découvrez notre boutique et ajoutez les articles
                                    qui vous plaisent à votre liste de favoris.
                                </p>

                                <a
                                    href="{{ path('app_shop') }}"
                                    class="mt-5 inline-flex rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                >
                                    Découvrir la boutique
                                </a>
                            </div>

                        {% else %}

                            {# Afficher les favoris enregistrés en base de données #}
                            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">

                                {% for favorite in favorites %}

                                    {% set product = favorite.product %}

                                    {# Récupérer le chemin correct de l'image principale #}
                                    {% if product.mainImage %}
                                        {% if product.mainImage starts with 'http://' or product.mainImage starts with 'https://' %}
                                            {% set imageUrl = product.mainImage %}
                                        {% elseif product.mainImage starts with '/' %}
                                            {% set imageUrl = product.mainImage %}
                                        {% elseif product.mainImage starts with 'images/' or product.mainImage starts with 'uploads/' %}
                                            {% set imageUrl = asset(product.mainImage) %}
                                        {% else %}
                                            {% set imageUrl = asset('images/products/' ~ product.mainImage) %}
                                        {% endif %}
                                    {% else %}
                                        {% set imageUrl = asset('images/products/sac-beige.jpg') %}
                                    {% endif %}

                                    <article class="group overflow-hidden rounded-2xl border border-beige bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg">

                                        <div class="relative overflow-hidden bg-cream">
                                            <a href="{{ path('app_product_detail', {slug: product.slug}) }}">
                                                <img
                                                    src="{{ imageUrl }}"
                                                    alt="{{ product.name }}"
                                                    loading="lazy"
                                                    class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"
                                                >
                                            </a>

                                            <span class="absolute left-3 top-3 rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-white">
                                                Favori
                                            </span>

                                            {# Formulaire de suppression du favori #}
                                            <form
                                                method="post"
                                                action="{{ path('app_favorite_remove', {id: favorite.id}) }}"
                                                class="absolute right-3 top-3"
                                            >
                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('favorite_remove_' ~ favorite.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    aria-label="Retirer {{ product.name }} des favoris"
                                                    title="Retirer des favoris"
                                                    class="flex h-10 w-10 items-center justify-center rounded-full border border-beige bg-white/95 text-red-600 shadow-sm transition hover:bg-red-600 hover:text-white"
                                                >
                                                    {{ ux_icon('lucide:trash-2', {class: 'h-5 w-5'}) }}
                                                </button>
                                            </form>
                                        </div>

                                        <div class="p-4">

                                            <p class="text-xs font-medium uppercase tracking-wider text-brand">
                                                {{ product.category ? product.category.name : 'Sans catégorie' }}
                                            </p>

                                            <h3 class="mt-2 font-semibold text-ink">
                                                <a
                                                    href="{{ path('app_product_detail', {slug: product.slug}) }}"
                                                    class="transition hover:text-brand"
                                                >
                                                    {{ product.name }}
                                                </a>
                                            </h3>

                                            <div class="mt-3 flex flex-wrap items-center gap-2">
                                                <span class="font-bold text-ink">
                                                    {{ product.price|number_format(0, ',', ' ') }} Ar
                                                </span>

                                                {% if product.oldPrice is not null %}
                                                    <span class="text-sm text-ink-soft line-through">
                                                        {{ product.oldPrice|number_format(0, ',', ' ') }} Ar
                                                    </span>
                                                {% endif %}
                                            </div>

                                            <a
                                                href="{{ path('app_product_detail', {slug: product.slug}) }}"
                                                class="mt-4 flex w-full items-center justify-center rounded-xl bg-ink px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand"
                                            >
                                                Voir le produit
                                            </a>
                                        </div>
                                    </article>

                                {% endfor %}

                            </div>

                        {% endif %}

                        <div class="mt-7 border-t border-beige pt-5">
                            <a
                                href="{{ path('app_shop') }}"
                                class="inline-flex items-center gap-2 text-sm font-semibold text-brand transition hover:text-brand-dark"
                            >
                                <span aria-hidden="true">←</span>
                                Continuer mes achats
                            </a>
                        </div>

                    </section>
                </main>
            </div>
        </div>
    </section>
{% endblock %}
