{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Mes commandes | ModeBoutique{% endblock %}

{% block body %}
    <section class="min-h-screen bg-cream px-4 py-8 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">

            {# En-tête de la page #}
            <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <a href="{{ path('home') }}" class="text-2xl font-bold text-ink">
                        Mode<span class="text-brand">Boutique</span>
                    </a>
                    <p class="mt-1 text-sm text-ink-soft">
                        Mon espace client / Mes commandes
                    </p>
                </div>

                <a
                    href="{{ path('app_account') }}"
                    class="rounded-full border border-beige bg-white px-5 py-3 text-sm font-semibold text-ink transition hover:border-brand hover:text-brand"
                >
                    ← Retour au tableau de bord
                </a>
            </header>

            <div class="grid gap-6 lg:grid-cols-[220px_1fr]">

                {# Menu latéral commun #}
                {% include 'pages/account/_sidebar.html.twig' with {
                activePage: 'orders'
            } %}

                {# Contenu de Mes commandes #}
                <main class="min-w-0 space-y-6">

                    {# Présentation #}
                    <section class="rounded-3xl border border-beige bg-gradient-to-br from-[#FBF7F1] to-[#E8DCCB] p-7 sm:p-9">
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-dark">
                            Mon historique
                        </p>

                        <h1 class="mt-3 text-3xl font-bold text-ink">
                            Mes commandes
                        </h1>

                        <p class="mt-3 max-w-xl text-sm leading-7 text-ink-soft">
                            Retrouvez vos achats, consultez les montants et suivez
                            l'état de vos commandes ModeBoutique.
                        </p>
                    </section>

                    {# Cartes de synthèse #}
                    <div class="grid gap-4 sm:grid-cols-3">

                        <article class="rounded-2xl border border-beige bg-white p-5 shadow-sm">
                            <p class="text-sm text-ink-soft">Total des commandes</p>
                            <p class="mt-3 text-3xl font-bold text-ink">
                                {{ totalOrders }}
                            </p>
                        </article>

                        <article class="rounded-2xl border border-beige bg-white p-5 shadow-sm">
                            <p class="text-sm text-ink-soft">En cours</p>
                            <p class="mt-3 text-3xl font-bold text-brand">
                                {{ processingCount }}
                            </p>
                        </article>

                        <article class="rounded-2xl border border-beige bg-white p-5 shadow-sm">
                            <p class="text-sm text-ink-soft">Livrées</p>
                            <p class="mt-3 text-3xl font-bold text-ink">
                                {{ deliveredCount }}
                            </p>
                        </article>

                    </div>

                    {# Historique des commandes #}
                    <section class="overflow-hidden rounded-3xl border border-beige bg-white shadow-sm">

                        <div class="border-b border-beige p-5 sm:p-6">
                            <h2 class="text-lg font-bold text-ink">
                                Historique des commandes
                            </h2>

                            <p class="mt-1 text-sm text-ink-soft">
                                Consultez le récapitulatif de vos achats.
                            </p>
                        </div>

                        {% if ordersData is not empty %}

                            <div class="overflow-x-auto">
                                <table class="w-full min-w-[650px] text-left text-sm">

                                    <thead class="bg-cream text-xs uppercase text-ink-soft">
                                        <tr>
                                            <th class="px-5 py-4 font-semibold">Commande</th>
                                            <th class="px-5 py-4 font-semibold">Date</th>
                                            <th class="px-5 py-4 font-semibold">Montant</th>
                                            <th class="px-5 py-4 font-semibold">Statut</th>
                                            <th class="px-5 py-4 font-semibold">Détails</th>
                                        </tr>
                                    </thead>

                                    <tbody class="divide-y divide-beige text-ink">

                                        {% for item in ordersData %}
                                            {% set order = item.order %}

                                            <tr class="transition hover:bg-cream/40">

                                                <td class="px-5 py-4 font-semibold">
                                                    #{{ order.orderNumber }}
                                                </td>

                                                <td class="whitespace-nowrap px-5 py-4 text-ink-soft">
                                                    {{ order.createdAt|date('d/m/Y') }}
                                                </td>

                                                <td class="whitespace-nowrap px-5 py-4 font-semibold">
                                                    {{ order.totalAmount|number_format(0, ',', ' ') }} Ar
                                                </td>

                                                <td class="px-5 py-4">
                                                    <span class="inline-flex whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-semibold {{ item.statusClass }}">
                                                        {{ item.statusLabel }}
                                                    </span>
                                                </td>

                                                <td class="px-5 py-4">
                                                    <a
                                                        href="{{ path('app_account_order_detail', {orderNumber: order.orderNumber}) }}"
                                                        class="whitespace-nowrap font-semibold text-brand transition hover:text-brand-dark"
                                                    >
                                                        Consulter →
                                                    </a>
                                                </td>

                                            </tr>
                                        {% endfor %}

                                    </tbody>
                                </table>
                            </div>

                        {% else %}

                            {# Aucun achat pour le moment #}
                            <div class="px-6 py-14 text-center">

                                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-cream text-3xl text-brand">
                                    ♡
                                </div>

                                <h3 class="mt-5 text-lg font-bold text-ink">
                                    Aucune commande pour le moment
                                </h3>

                                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-ink-soft">
                                    Vous n'avez pas encore effectué de commande.
                                    Découvrez notre boutique et trouvez vos prochains articles préférés.
                                </p>

                                <a
                                    href="{{ path('app_shop') }}"
                                    class="mt-6 inline-flex items-center justify-center rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                >
                                    Découvrir la boutique
                                    <span class="ml-2">→</span>
                                </a>

                            </div>

                        {% endif %}

                    </section>

                </main>
            </div>
        </div>
    </section>
{% endblock %}
