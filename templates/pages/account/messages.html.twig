{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Mes messages | ModeBoutique{% endblock %}

{% block body %}
<section class="min-h-screen bg-cream px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">

        {# En-tête de la page #}
        <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
            <div>
                <p class="mb-2 text-sm font-medium text-brand">Mon espace client</p>
                <h1 class="text-2xl font-bold text-ink sm:text-3xl">
                    Mes messages
                </h1>
                <p class="mt-2 text-sm text-ink-soft">
                    Retrouvez ici toutes vos conversations avec notre équipe.
                </p>
            </div>

            <a href="{{ path('app_account') }}"
               class="inline-flex items-center rounded-xl border border-stone-300 bg-white px-4 py-2.5 text-sm font-medium text-ink transition hover:bg-stone-50">
                ← Retour au compte
            </a>
        </header>

        {# Messages flash #}
        {% for message in app.flashes('success') %}
            <div class="mb-5 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                {{ message }}
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-4">

            {# Barre latérale du compte #}
            <aside class="lg:col-span-1">
                {% include 'pages/account/_sidebar.html.twig' with {
                    activePage: 'messages'
                } %}
            </aside>

            {# Liste des conversations #}
            <div class="lg:col-span-3">

                {% if messages is empty %}
                    <div class="rounded-2xl border border-stone-200 bg-white px-6 py-16 text-center shadow-sm">
                        <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-stone-100">
                            <span class="text-3xl">✉</span>
                        </div>

                        <h2 class="text-lg font-semibold text-ink">
                            Aucune conversation
                        </h2>

                        <p class="mx-auto mt-2 max-w-md text-sm text-ink-soft">
                            Vous n'avez pas encore échangé de messages avec notre équipe.
                        </p>

                        <a href="{{ path('app_contact') }}"
                           class="mt-6 inline-flex items-center rounded-xl bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90">
                            Nous contacter
                        </a>
                    </div>

                {% else %}
                    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-semibold text-ink">
                                Toutes mes conversations
                            </h2>
                            <p class="mt-1 text-sm text-ink-soft">
                                {{ messages|length }} conversation(s)
                            </p>
                        </div>
                    </div>

                    <div class="space-y-4">
                        {% for message in messages %}

                            {# Déterminer le statut de lecture des réponses administrateur #}
                            {% set hasUnreadAdminReply = false %}

                            {% for reply in message.messageReplies %}
                                {% if reply.sender and 'ROLE_ADMIN' in reply.sender.roles and not reply.isReadByClient %}
                                    {% set hasUnreadAdminReply = true %}
                                {% endif %}
                            {% endfor %}

                            {# Traduire le sujet en français #}
                            {% set subjectLabel = 'Sans sujet' %}

                            {% if message.subject == 'delivery' %}
                                {% set subjectLabel = 'Livraison' %}
                            {% elseif message.subject == 'order' %}
                                {% set subjectLabel = 'Commande' %}
                            {% elseif message.subject == 'other' %}
                                {% set subjectLabel = 'Autre' %}
                            {% elseif message.subject %}
                                {% set subjectLabel = message.subject %}
                            {% endif %}

                            <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm transition hover:border-brand/40 hover:shadow-md sm:p-6">

                                <div class="flex flex-wrap items-start justify-between gap-4">

                                    <div class="min-w-0 flex-1">
                                        <div class="mb-3 flex flex-wrap items-center gap-2">
                                            <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-700">
                                                {{ subjectLabel }}
                                            </span>

                                            {% if hasUnreadAdminReply %}
                                                <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                                    Non lu
                                                </span>
                                            {% else %}
                                                <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">
                                                    Lu
                                                </span>
                                            {% endif %}
                                        </div>

                                        <h3 class="font-semibold text-ink">
                                            Conversation #{{ message.id }}
                                        </h3>

                                        <p class="mt-2 line-clamp-2 text-sm leading-6 text-ink-soft">
                                            {{ message.message }}
                                        </p>

                                        <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-stone-500">
                                            <span>
                                                <span class="mr-1">📅</span>
                                                {{ message.createdAt|date('d/m/Y à H:i') }}
                                            </span>

                                            <span>
                                                <span class="mr-1">💬</span>
                                                {{ message.messageReplies|length }} réponse(s)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="shrink-0">
                                        <a href="{{ path('app_account_message_show', {id: message.id}) }}"
                                           class="inline-flex items-center justify-center rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-white transition hover:opacity-90">
                                            Lire la conversation
                                            <span class="ml-2">→</span>
                                        </a>
                                    </div>

                                </div>
                            </article>
                        {% endfor %}
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
</section>
{% endblock %}
