{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Renvoyer l'e-mail de confirmation | ModeBoutique{% endblock %}

{% block body %}
    <section class="min-h-screen bg-cream px-4 py-12 sm:px-6 lg:px-8">
        <div class="mx-auto flex min-h-[70vh] max-w-lg items-center justify-center">
            <div class="w-full rounded-3xl border border-beige bg-white p-6 shadow-sm sm:p-10">

                {# En-tête de la page #}
                <div class="mb-8 text-center">
                    <a href="{{ path('home') }}" class="text-2xl font-bold tracking-wide text-ink">
                        Mode<span class="text-brand">Boutique</span>
                    </a>

                    <h1 class="mt-6 text-2xl font-bold text-ink">
                        Confirmer votre adresse e-mail
                    </h1>

                    <p class="mt-3 text-sm leading-6 text-ink-soft">
                        Vous n'avez pas reçu votre e-mail de confirmation
                        ou votre ancien lien a expiré ?
                        Saisissez votre adresse e-mail pour recevoir un nouveau lien.
                    </p>
                </div>

                {# Messages de retour #}
                {% for message in app.flashes('success') %}
                    <div role="status" class="mb-5 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">
                        {{ message }}
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div role="alert" class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                        {{ message }}
                    </div>
                {% endfor %}

                {# Formulaire de demande d'un nouveau lien #}
                <form method="post" class="space-y-5">
                    <div>
                        <label for="email" class="mb-2 block text-sm font-semibold text-ink">
                            Adresse e-mail
                        </label>

                        <input
                            type="email"
                            name="email"
                            id="email"
                            placeholder="exemple@email.com"
                            autocomplete="email"
                            required
                            class="w-full rounded-xl border border-beige bg-white px-4 py-3 text-ink placeholder:text-ink-soft focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20"
                        >
                    </div>

                    {# Protection contre les requêtes CSRF #}
                    <input
                        type="hidden"
                        name="_token"
                        value="{{ csrf_token('resend_verification') }}"
                    >

                    <button
                        type="submit"
                        class="w-full rounded-full bg-brand px-6 py-3.5 font-semibold text-white transition hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
                    >
                        Renvoyer l'e-mail de confirmation
                    </button>
                </form>

                {# Retour vers la connexion #}
                <p class="mt-7 text-center text-sm text-ink-soft">
                    Vous avez déjà confirmé votre adresse ?

                    <a href="{{ path('app_login') }}" class="font-semibold text-brand underline-offset-4 hover:underline">
                        Se connecter
                    </a>
                </p>

            </div>
        </div>
    </section>
{% endblock %}
