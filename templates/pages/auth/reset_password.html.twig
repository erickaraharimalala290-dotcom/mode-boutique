{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Réinitialiser mon mot de passe | ModeBoutique{% endblock %}

{% block body %}
<section class="min-h-screen bg-cream px-4 py-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-6xl">

        <div class="mb-8">
            <a href="{{ path('app_login') }}"
               class="inline-flex items-center gap-2 text-sm font-medium text-ink-soft transition hover:text-brand">
                <span aria-hidden="true">←</span>
                Retour à la connexion
            </a>
        </div>

        <div class="grid overflow-hidden rounded-3xl border border-beige bg-white shadow-sm lg:grid-cols-2">

            {# Image de présentation #}
            <div class="relative hidden min-h-[580px] overflow-hidden p-10 text-white lg:flex lg:flex-col lg:justify-between xl:p-14">

                <img
                    src="{{ asset('images/products/sweat-blanc-homme.jpg') }}"
                    alt="Collection ModeBoutique"
                    class="absolute inset-0 h-full w-full object-cover object-center"
                >

                <div class="absolute inset-0 bg-gradient-to-t from-[#292524]/85 via-[#292524]/20 to-[#B08D67]/10"></div>

                <div class="relative z-10">
                    <a href="{{ path('home') }}"
                       class="text-2xl font-bold tracking-wide">
                        Mode<span class="text-[#D6B58A]">Boutique</span>
                    </a>

                    <p class="mt-3 text-sm text-white/90">
                        Votre boutique de mode, simplement.
                    </p>
                </div>

                <div class="relative z-10 py-12">
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#D6B58A]">
                        Sécurité de votre compte
                    </p>

                    <h1 class="max-w-md text-4xl font-bold leading-tight xl:text-5xl">
                        Un nouveau départ.
                    </h1>

                    <p class="mt-6 max-w-md leading-7 text-white/90">
                        Choisissez un nouveau mot de passe pour retrouver
                        l'accès à votre espace personnel.
                    </p>
                </div>

                <p class="relative z-10 border-t border-white/30 pt-5 text-sm text-white/90">
                    ModeBoutique — La mode pour tous.
                </p>
            </div>

            {# Formulaire de réinitialisation #}
            <div class="flex items-center p-6 sm:p-10 xl:p-14">
                <div class="w-full">

                    <div class="mb-8">
                        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand">
                            Récupération du compte
                        </p>

                        <h2 class="text-3xl font-bold text-ink">
                            Nouveau mot de passe
                        </h2>

                        <p class="mt-3 text-sm leading-6 text-ink-soft">
                            Saisissez votre nouveau mot de passe,
                            puis confirmez-le pour éviter les erreurs.
                        </p>
                    </div>

                    {# Messages d'erreur #}
                    {% for message in app.flashes('reset_password_error') %}
                        <div role="alert"
                             class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {% for message in app.flashes('reset_password_info') %}
                        <div role="status"
                             class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-6 text-amber-900">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {# Utiliser le véritable formulaire Symfony #}
                    {{ form_start(resetForm, {
                        action: path('app_reset_password'),
                        attr: {
                            class: 'space-y-5'
                        }
                    }) }}

                        {# Nouveau mot de passe #}
                        <div>
                            {{ form_label(
                                resetForm.plainPassword.first,
                                'Nouveau mot de passe',
                                {
                                    label_attr: {
                                        class: 'mb-2 block text-sm font-semibold text-ink'
                                    }
                                }
                            ) }}

                            {{ form_widget(
                                resetForm.plainPassword.first,
                                {
                                    attr: {
                                        placeholder: 'Au moins 8 caractères',
                                        autocomplete: 'new-password',
                                        minlength: 8,
                                        class: 'w-full rounded-xl border border-beige bg-white px-4 py-3 text-ink placeholder:text-ink-soft focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20'
                                    }
                                }
                            ) }}

                            {{ form_errors(resetForm.plainPassword.first) }}

                            <p class="mt-2 text-xs text-ink-soft">
                                Choisissez un mot de passe difficile à deviner.
                            </p>
                        </div>

                        {# Confirmation du mot de passe #}
                        <div>
                            {{ form_label(
                                resetForm.plainPassword.second,
                                'Confirmer le nouveau mot de passe',
                                {
                                    label_attr: {
                                        class: 'mb-2 block text-sm font-semibold text-ink'
                                    }
                                }
                            ) }}

                            {{ form_widget(
                                resetForm.plainPassword.second,
                                {
                                    attr: {
                                        placeholder: 'Répétez le nouveau mot de passe',
                                        autocomplete: 'new-password',
                                        minlength: 8,
                                        class: 'w-full rounded-xl border border-beige bg-white px-4 py-3 text-ink placeholder:text-ink-soft focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20'
                                    }
                                }
                            ) }}

                            {{ form_errors(resetForm.plainPassword.second) }}
                            {{ form_errors(resetForm.plainPassword) }}
                        </div>

                        {# Erreurs générales du formulaire #}
                        {{ form_errors(resetForm) }}

                        <button
                            type="submit"
                            class="w-full rounded-full bg-brand px-6 py-3.5 font-semibold text-white transition hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
                        >
                            Enregistrer le nouveau mot de passe
                        </button>

                    {{ form_end(resetForm) }}

                    <p class="mt-7 text-center text-sm text-ink-soft">
                        Vous vous souvenez de votre mot de passe ?
                        <a href="{{ path('app_login') }}"
                           class="font-semibold text-brand transition hover:text-brand-dark hover:underline">
                            Se connecter
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}