{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Vérification de votre adresse e-mail | ModeBoutique{% endblock %}

{% block body %}
    <section class="min-h-screen bg-cream px-4 py-12 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">

            <div class="grid overflow-hidden rounded-3xl border border-beige bg-white shadow-sm lg:grid-cols-2">

                {# Partie présentation avec image de fond #}
                <div class="relative hidden min-h-[650px] flex-col justify-between overflow-hidden p-10 text-white lg:flex xl:p-14">

                    <img
                        src="{{ asset('images/products/robe-soirée-marron.jpg') }}"
                        alt="Collection ModeBoutique"
                        class="absolute inset-0 h-full w-full object-cover object-center"
                    >

                    <div class="absolute inset-0 bg-gradient-to-t from-[#292524]/90 via-[#292524]/40 to-[#B08D67]/20"></div>

                    <div class="relative z-10">
                        <a href="{{ path('home') }}" class="inline-block text-2xl font-bold tracking-wide">
                            Mode<span class="text-[#D6B58A]">Boutique</span>
                        </a>

                        <p class="mt-3 text-sm leading-6 text-white/90">
                            Votre boutique de mode, simplement.
                        </p>
                    </div>

                    <div class="relative z-10 py-12">
                        <span class="mb-4 inline-block rounded-full border border-white/40 bg-white/15 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] backdrop-blur-sm">
                            Bienvenue chez ModeBoutique
                        </span>

                        <h1 class="max-w-md text-4xl font-bold leading-tight xl:text-5xl">
                            Encore une étape avant de vous accueillir.
                        </h1>

                        <p class="mt-6 max-w-md text-base leading-7 text-white/90">
                            Votre compte est presque prêt. Confirmez simplement
                            votre adresse e-mail pour profiter pleinement de
                            votre expérience ModeBoutique.
                        </p>
                    </div>

                    <div class="relative z-10 flex items-center justify-between gap-4 border-t border-white/30 pt-5">
                        <p class="text-sm text-white/90">
                            ModeBoutique — La mode pour tous.
                        </p>
                        <span class="text-xl text-[#D6B58A]" aria-hidden="true">✦</span>
                    </div>
                </div>

                {# Partie confirmation de l'adresse e-mail #}
                <div class="flex items-center p-6 sm:p-10 xl:p-14">

                    <div class="w-full">

                        <div class="mb-7 text-center">

                            {# Icône e-mail #}
                            <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-[#F5F0E8]">
                                <span class="text-4xl text-brand" aria-hidden="true">✉</span>
                            </div>

                            <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-brand">
                                Dernière étape
                            </p>

                            <h2 class="text-3xl font-bold text-ink">
                                Vérifiez votre adresse e-mail
                            </h2>

                            <p class="mt-4 text-sm leading-7 text-ink-soft">
                                Votre compte ModeBoutique a bien été créé !
                                Pour l'activer et accéder à votre compte,
                                veuillez confirmer votre adresse e-mail.
                            </p>
                        </div>

                        {# Adresse e-mail utilisée lors de l'inscription #}
                        <div class="mb-7 rounded-2xl border border-beige bg-cream p-4">
                            <p class="text-xs font-semibold uppercase tracking-wider text-ink-soft">
                                E-mail de confirmation envoyé à
                            </p>

                            <p class="mt-2 break-all text-base font-semibold text-ink">
                                {{ email }}
                            </p>
                        </div>

                        {# Étapes à suivre #}
                        <div class="mb-7">
                            <h3 class="mb-4 text-sm font-bold text-ink">
                                Que devez-vous faire ?
                            </h3>

                            <div class="space-y-4">

                                <div class="flex items-start gap-3">
                                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#F5F0E8] text-sm font-bold text-brand">
                                        1
                                    </span>
                                    <div>
                                        <p class="text-sm font-semibold text-ink">
                                            Ouvrez votre boîte e-mail
                                        </p>
                                        <p class="mt-1 text-sm leading-6 text-ink-soft">
                                            Consultez la boîte de réception de l'adresse utilisée lors de votre inscription.
                                        </p>
                                    </div>
                                </div>

                                <div class="flex items-start gap-3">
                                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#F5F0E8] text-sm font-bold text-brand">
                                        2
                                    </span>
                                    <div>
                                        <p class="text-sm font-semibold text-ink">
                                            Recherchez l'e-mail ModeBoutique
                                        </p>
                                        <p class="mt-1 text-sm leading-6 text-ink-soft">
                                            Ouvrez le message de confirmation que nous venons de vous envoyer.
                                        </p>
                                    </div>
                                </div>

                                <div class="flex items-start gap-3">
                                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#F5F0E8] text-sm font-bold text-brand">
                                        3
                                    </span>
                                    <div>
                                        <p class="text-sm font-semibold text-ink">
                                            Confirmez votre adresse e-mail
                                        </p>
                                        <p class="mt-1 text-sm leading-6 text-ink-soft">
                                            Cliquez sur le bouton « Confirmer mon adresse e-mail » dans le message reçu.
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </div>

                        {# Information sur les courriers indésirables #}
                        <div class="mb-6 rounded-xl border border-[#E7DED2] bg-[#FAF7F2] p-4">
                            <p class="text-sm font-semibold text-ink">
                                Vous ne trouvez pas l'e-mail ?
                            </p>
                            <p class="mt-2 text-sm leading-6 text-ink-soft">
                                Pensez à vérifier votre dossier Spam ou Courriers indésirables.
                                Le message peut parfois s'y retrouver.
                            </p>
                        </div>

                        {# Statut de vérification automatique #}
                        <div
                            id="verification-status"
                            data-status-url="{{ path('app_registration_status') }}"
                            data-login-url="{{ path('app_login') }}"
                            role="status"
                            aria-live="polite"
                            class="flex items-center justify-center gap-3 rounded-xl bg-[#F5F0E8] px-4 py-4 text-center text-sm font-medium text-ink-soft"
                        >
                            <span class="h-5 w-5 animate-spin rounded-full border-2 border-[#D6C2A8] border-t-brand"></span>
                            En attente de la confirmation de votre adresse e-mail...
                        </div>

                        <p class="mt-5 text-center text-xs leading-6 text-ink-soft">
                            Cette page restera ouverte et vérifiera automatiquement
                            votre confirmation. Vous serez redirigé vers la connexion
                            dès que votre adresse e-mail sera confirmée.
                        </p>

                        {# Lien pour demander un nouvel e-mail #}
                        <p class="mt-5 text-center text-sm text-ink-soft">
                            Vous n'avez pas reçu l'e-mail ?
                            <a
                                href="{{ path('app_resend_verification') }}"
                                target="_blank"
                                rel="noopener"
                                class="font-semibold text-brand underline-offset-4 hover:underline"
                            >
                                Renvoyer un lien de confirmation
                            </a>
                        </p>

                    </div>
                </div>
            </div>

            <p class="mt-6 text-center text-xs text-ink-soft">
                © {{ "now"|date("Y") }} ModeBoutique. Tous droits réservés.
            </p>

        </div>
    </section>

    {# Vérifier automatiquement si l'adresse e-mail a été confirmée #}  
<script>
    const statusElement = document.getElementById('verification-status');

    async function checkEmailVerification() {
        try {
            const response = await fetch(statusElement.dataset.statusUrl);
            const data = await response.json();

            if (response.ok && data.verified) {
                window.location.href = statusElement.dataset.loginUrl;
            }
        } catch (error) {
            // Réessayer automatiquement en cas d'erreur.
        }
    }

    // Vérifier toutes les 5 secondes.
    checkEmailVerification();
    setInterval(checkEmailVerification, 5000);
</script>

{% endblock %}
