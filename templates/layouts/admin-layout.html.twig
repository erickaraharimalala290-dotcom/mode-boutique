{% extends 'layouts/auth-layout.html.twig' %}

{% block title %}Administration | ModeBoutique{% endblock %}

{% block body %}
    {% set currentRoute = app.request.attributes.get('_route') %}
    {% set unreadMessagesCount = admin_unread_messages_count() %}
    {# Nombre de demandes de retour qui attendent un traitement #}
    {% set pendingReturnRequestsCount = admin_pending_return_requests_count() %}

    <div class="min-h-screen bg-[#F5F0E8] text-[#292524] lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">

        {# ================= SIDEBAR DESKTOP ================= #}
        <aside class="relative hidden flex-col bg-[#292524] text-white lg:sticky lg:top-0 lg:flex lg:h-screen">

            {# Logo #}
            <div class="flex items-center justify-between border-b border-white/10 px-6 py-7">
                <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-3">
                    <span class="text-3xl text-[#B08D67]">♧</span>
                    <span class="text-xl font-bold tracking-tight">
                        Mode<span class="font-normal text-[#B08D67]">Boutique</span>
                    </span>
                </a>

                <span class="rounded-lg bg-[#B08D67]/20 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-[#E7C9A7]">
                    {{ is_granted('ROLE_ADMIN') ? 'Admin' : 'Manager' }}
                </span>
            </div>

            {# Navigation desktop #}
            <nav class="flex-1 space-y-2 overflow-y-auto px-4 py-7">

                <a
                    href="{{ path('admin_dashboard') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                    {{ currentRoute == 'admin_dashboard'
                  ? 'bg-[#B08D67] text-white shadow-md'
                  : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">▦</span>
                    <span class="flex-1">Tableau de bord</span>
                </a>

                <p class="px-3 pb-1 pt-7 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-500">
                    Gestion de la boutique
                </p>

                {# Produits #}
                <a
                    href="{{ path('admin_products_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
               {{ currentRoute starts with 'admin_products_'
                  ? 'bg-[#B08D67] text-white shadow-md'
                  : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">◇</span>
                    <span class="flex-1">Produits</span>
                </a>

                {# Catégories #}
                <a
                    href="{{ path('admin_categories_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
               {{ currentRoute starts with 'admin_categories_'
                  ? 'bg-[#B08D67] text-white shadow-md'
                  : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">▦</span>
                    <span class="flex-1">Catégories</span>
                </a>

                {# Gestion du stock #}
                <a
                    href="{{ path('admin_stock_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                    {{ currentRoute starts with 'admin_stock_'
                        ? 'bg-[#B08D67] text-white shadow-md'
                        : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">▧</span>
                    <span class="flex-1">Gestion du stock</span>
                </a>

                <p class="px-3 pb-1 pt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-500">
                    Ventes et logistique
                </p>

                {# Commandes #}
                <a
                    href="{{ path('admin_orders_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                    {{ currentRoute starts with 'admin_orders_'
                    ? 'bg-[#B08D67] font-semibold text-white'
                    : 'text-stone-300 hover:bg-[#F5F0E8]' }}"
                >
                    <span class="text-lg">▣</span>
                    <span>Commandes</span>

                    {% set pendingCount = admin_pending_orders_count() %}

                    {% if pendingCount > 0 %}
                        <span class="ml-auto inline-flex min-w-6 h-6 items-center justify-center rounded-full bg-amber-100 px-2 text-xs font-bold text-amber-800">
                            {{ pendingCount }}
                        </span>
                    {% endif %}
                </a>

                {# Factures #}
                <a
                    href="{{ path('admin_invoices_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                    {{ currentRoute starts with 'admin_invoices_'
                    ? 'bg-[#B08D67] font-semibold text-white'
                    : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-lg">▤</span>
                    <span>Factures</span>
                </a>

                {# Livraisons #}
                <a
                    href="{{ path('admin_deliveries_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                {{ currentRoute starts with 'admin_deliveries_'
                    ? 'bg-[#B08D67] text-white shadow-md'
                    : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-5 w-5 shrink-0"
                    >
                        <path d="M10 17h4V5H2v12h3"/>
                        <path d="M14 9h4l4 4v4h-3"/>
                        <circle cx="7.5" cy="17.5" r="2.5"/>
                        <circle cx="17.5" cy="17.5" r="2.5"/>
                    </svg>
                    <span class="flex-1">Livraisons</span>
                </a>

                {# Demandes de retour #}
                <a
                    href="{{ path('admin_return_requests_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                        {{ currentRoute starts with 'admin_return_requests_'
                        ? 'bg-[#B08D67] text-white shadow-md'
                        : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">↩</span>
                    <span class="flex-1">Demandes de retour</span>

                    {# Compteur actualisable automatiquement des demandes de retour #}
                    <span
                        data-notification-count="returns"
                        class="{{ pendingReturnRequestsCount > 0 ? 'inline-flex' : 'hidden' }} h-6 min-w-6 items-center justify-center rounded-full bg-amber-100 px-2 text-xs font-bold text-amber-800"
                    >
                        {{ pendingReturnRequestsCount }}
                    </span>
                </a>

                <p class="px-3 pb-1 pt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-500">
                    Relation client
                </p>

                {# Clients #}
                <a
                    href="{{ path('admin_customers_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
               {{ currentRoute starts with 'admin_customers_'
                  ? 'bg-[#B08D67] text-white shadow-md'
                  : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">♙</span>
                    <span class="flex-1">Clients</span>
                </a>

                {# Messages clients #}
                <a
                    href="{{ path('admin_messages_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                    {{ currentRoute starts with 'admin_messages_'
                    ? 'bg-[#B08D67] text-white shadow-md'
                    : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">✉</span>
                    <span class="flex-1">Messages clients</span>

                    {# Compteur actualisable automatiquement des messages non lus #}
                    <span
                        data-notification-count="messages"
                        class="{{ unreadMessagesCount > 0 ? 'inline-flex' : 'hidden' }} min-w-6 h-6 items-center justify-center rounded-full bg-amber-100 px-2 text-xs font-bold text-amber-800"
                    >
                        {{ unreadMessagesCount }}
                    </span>
                </a>

                {# Avis clients #}
                <a
                    href="{{ path('admin_reviews_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                    {{ currentRoute starts with 'admin_reviews_'
                    ? 'bg-[#B08D67] text-white shadow-md'
                    : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">★</span>
                    <span class="flex-1">Avis clients</span>
                </a>

                {# Favoris clients #}
                <a
                    href="{{ path('admin_favorites_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                    {{ currentRoute starts with 'admin_favorites_'
                    ? 'bg-[#B08D67] text-white shadow-md'
                    : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-xl">♡</span>
                    <span class="flex-1">Favoris clients</span>
                </a>

                <p class="px-3 pb-1 pt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-500">
                    Marketing
                </p>

                {# Promotions #}
                <a
                    href="{{ path('admin_promotions_index') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
               {{ currentRoute starts with 'admin_promotions_'
                  ? 'bg-[#B08D67] text-white shadow-md'
                  : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                >
                    <span class="text-lg">%</span>
                    <span class="flex-1">Promotions</span>
                </a>

                <p class="px-3 pb-1 pt-6 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-500">
                    Configuration
                </p>

                {% if is_granted('ROLE_ADMIN') %}
                    {# Paramètres accessibles uniquement à l'administrateur #}
                    <a
                        href="{{ path('admin_settings_index') }}"
                        class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                        {{ currentRoute starts with 'admin_settings_'
                        ? 'bg-[#B08D67] text-white shadow-md'
                        : 'text-stone-300 hover:bg-white/5 hover:text-white' }}"
                    >
                        <span class="text-xl">⚙</span>
                        <span class="flex-1">Paramètres</span>
                    </a>
                {% endif %}

                <div class="my-6 border-t border-white/10"></div>

                <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-500">
                    Autres
                </p>

                <a
                    href="{{ path('home') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-stone-300 transition hover:bg-white/5 hover:text-white"
                >
                    <span class="text-lg">↗</span>
                    <span>Voir la boutique</span>
                </a>

                <a
                    href="{{ path('app_logout') }}"
                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-stone-300 transition hover:bg-red-500/10 hover:text-red-300"
                >
                    <span class="text-lg">⇥</span>
                    <span>Déconnexion</span>
                </a>

            </nav>

            {# Signature #}
            <div class="border-t border-white/10 px-5 py-7 text-center">
                <p class="font-serif text-2xl italic text-[#D6B58A]">
                    Mode & Élégance
                </p>
                <p class="mt-2 text-xs text-stone-400">
                    La mode à portée de clic
                </p>
                <p class="mt-4 text-[#B08D67]">— ♡ —</p>
            </div>
        </aside>

        {# ================= CONTENU PRINCIPAL ================= #}
        <div class="min-w-0">

            {# TOPBAR #}
            <header class="sticky top-0 z-20 border-b border-[#E5D9CA] bg-white/95 px-4 py-4 backdrop-blur sm:px-7 lg:px-10">

                <div class="flex items-center justify-between gap-3">

                    <div class="flex min-w-0 flex-1 items-center gap-3">

                        {# MENU MOBILE FONCTIONNEL SANS JAVASCRIPT #}
                        <details class="group relative shrink-0 lg:hidden">

                            <summary
                                aria-label="Ouvrir le menu de navigation"
                                class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl border border-[#E5D9CA] text-xl transition hover:bg-[#F5F0E8] [&::-webkit-details-marker]:hidden"
                            >
                                <span class="group-open:hidden">☰</span>
                                <span class="hidden group-open:inline">✕</span>
                            </summary>

                            <nav class="absolute left-0 top-full z-50 mt-3 max-h-[75vh] w-72 max-w-[calc(100vw-2rem)] space-y-1 overflow-y-auto rounded-2xl border border-[#E5D9CA] bg-white p-3 text-stone-700 shadow-2xl">

                                <p class="px-3 pb-2 pt-1 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">
                                    Administration
                                </p>

                                <a
                                    href="{{ path('admin_dashboard') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                               {{ currentRoute == 'admin_dashboard'
                                  ? 'bg-[#B08D67] font-semibold text-white'
                                  : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">▦</span>
                                    Tableau de bord
                                </a>

                                <p class="px-3 pb-1 pt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">
                                    Gestion de la boutique
                                </p>

                                <a
                                    href="{{ path('admin_products_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                               {{ currentRoute starts with 'admin_products_'
                                  ? 'bg-[#B08D67] font-semibold text-white'
                                  : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">◇</span>
                                    Produits
                                </a>

                                <a
                                    href="{{ path('admin_categories_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                {{ currentRoute starts with 'admin_categories_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">▦</span>
                                    Catégories
                                </a>

                                <a
                                    href="{{ path('admin_stock_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                {{ currentRoute starts with 'admin_stock_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">▧</span>
                                    Gestion du stock
                                </a>

                                <p class="px-3 pb-1 pt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">
                                    Ventes et logistique
                                </p>

                                {# Commandes #}
                                <a
                                    href="{{ path('admin_orders_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                    {{ currentRoute starts with 'admin_orders_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">▣</span>
                                    <span>Commandes</span>

                                    {% if pendingCount > 0 %}
                                        <span class="ml-auto inline-flex min-w-6 h-6 items-center justify-center rounded-full bg-amber-100 px-2 text-xs font-bold text-amber-800">
                                            {{ pendingCount }}
                                        </span>
                                    {% endif %}
                                </a>

                                {# Factures #}
                                <a
                                    href="{{ path('admin_invoices_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                    {{ currentRoute starts with 'admin_invoices_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">▤</span>
                                    <span>Factures</span>
                                </a>

                                {# Livraisons #}
                                <a
                                    href="{{ path('admin_deliveries_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                {{ currentRoute starts with 'admin_deliveries_'
                                ? 'bg-[#B08D67] font-semibold text-white'
                                : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.7"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        class="h-5 w-5 shrink-0"
                                    >
                                        <path d="M10 17h4V5H2v12h3"/>
                                        <path d="M14 9h4l4 4v4h-3"/>
                                        <circle cx="7.5" cy="17.5" r="2.5"/>
                                        <circle cx="17.5" cy="17.5" r="2.5"/>
                                    </svg>
                                    Livraisons
                                </a>

                                {# Demandes de retour #}
                                <a
                                    href="{{ path('admin_return_requests_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                        {{ currentRoute starts with 'admin_return_requests_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">↩</span>
                                    <span class="flex-1">Demandes de retour</span>

                                    {# Compteur actualisable automatiquement des demandes de retour #}
                                    <span
                                        data-notification-count="returns"
                                        class="{{ pendingReturnRequestsCount > 0 ? 'inline-flex' : 'hidden' }} h-6 min-w-6 items-center justify-center rounded-full bg-amber-100 px-2 text-xs font-bold text-amber-800"
                                    >
                                        {{ pendingReturnRequestsCount }}
                                    </span>
                                </a>

                                <p class="px-3 pb-1 pt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">
                                    Relation client
                                </p>

                                <a
                                    href="{{ path('admin_customers_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                               {{ currentRoute starts with 'admin_customers_'
                                  ? 'bg-[#B08D67] font-semibold text-white'
                                  : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">♙</span>
                                    Clients
                                </a>

                                {# Messages clients #}
                                <a
                                    href="{{ path('admin_messages_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                    {{ currentRoute starts with 'admin_messages_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">✉</span>
                                    <span class="flex-1">Messages clients</span>

                                    {# Compteur actualisable automatiquement des messages non lus #}
                                    <span
                                        data-notification-count="messages"
                                        class="{{ unreadMessagesCount > 0 ? 'inline-flex' : 'hidden' }} min-w-6 h-6 items-center justify-center rounded-full bg-amber-100 px-2 text-xs font-bold text-amber-800"
                                    >
                                        {{ unreadMessagesCount }}
                                    </span>
                                </a>

                                <a
                                    href="{{ path('admin_reviews_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                    {{ currentRoute starts with 'admin_reviews_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">★</span>
                                    Avis clients
                                </a>

                                <a
                                    href="{{ path('admin_favorites_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                    {{ currentRoute starts with 'admin_favorites_'
                                    ? 'bg-[#B08D67] font-semibold text-white'
                                    : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">♡</span>
                                    Favoris clients
                                </a>

                                <p class="px-3 pb-1 pt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">
                                    Marketing
                                </p>

                                <a
                                    href="{{ path('admin_promotions_index') }}"
                                    class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                               {{ currentRoute starts with 'admin_promotions_'
                                  ? 'bg-[#B08D67] font-semibold text-white'
                                  : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                >
                                    <span class="text-lg">%</span>
                                    Promotions
                                </a>

                                <p class="px-3 pb-1 pt-4 text-[10px] font-bold uppercase tracking-[0.2em] text-stone-400">
                                    Configuration
                                </p>

                                {% if is_granted('ROLE_ADMIN') %}
                                    {# Paramètres accessibles uniquement à l'administrateur #}
                                    <a
                                        href="{{ path('admin_settings_index') }}"
                                        class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition
                                        {{ currentRoute starts with 'admin_settings_'
                                        ? 'bg-[#B08D67] font-semibold text-white'
                                        : 'text-stone-600 hover:bg-[#F5F0E8]' }}"
                                    >
                                        <span class="text-lg">⚙</span>
                                        Paramètres
                                    </a>
                                {% endif %}

                                <div class="mt-3 border-t border-[#E5D9CA] pt-3">
                                    <a
                                        href="{{ path('home') }}"
                                        class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-stone-600 transition hover:bg-[#F5F0E8]"
                                    >
                                        <span>↗</span>
                                        Voir la boutique
                                    </a>

                                    <a
                                        href="{{ path('app_logout') }}"
                                        class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm text-red-700 transition hover:bg-red-50"
                                    >
                                        <span>⇥</span>
                                        Déconnexion
                                    </a>
                                </div>

                            </nav>
                        </details>

                        {# Barre de recherche globale #}
                        <form action="{{ path('admin_search') }}" method="get" class="min-w-0 flex-1 sm:max-w-sm">
                            <label for="admin-search" class="sr-only">Rechercher</label>

                            <div class="flex items-center gap-3 rounded-xl border border-[#E5D9CA] bg-[#FCFAF7] px-4 py-2.5">
                                <span class="text-xl text-stone-400">⌕</span>

                                <input
                                    id="admin-search"
                                    type="search"
                                    name="q"
                                    value="{{ app.request.query.get('q', '') }}"
                                    placeholder="Rechercher..."
                                    class="w-full min-w-0 border-0 bg-transparent text-sm text-[#292524] outline-none placeholder:text-stone-400 focus:ring-0"
                                >
                            </div>
                        </form>
                    </div>

                    {# Profil administrateur et gestionnaire #}
                    <div class="relative flex shrink-0 items-center gap-3 sm:gap-5">

                        <span class="relative hidden text-xl text-stone-600 sm:inline-block">
                            ♧
                            <span class="absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full bg-[#B08D67] ring-2 ring-white"></span>
                        </span>

                        <details class="group relative">

                            {# Bouton du profil #}
                            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full transition hover:opacity-80 sm:gap-3">

                                <div class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full border border-[#E5D9CA] bg-[#F5F0E8] font-semibold text-[#8C694A] sm:h-10 sm:w-10">
                                    {% if app.user.profilePicture %}
                                        <img
                                            src="{{ asset('uploads/profile/' ~ app.user.profilePicture) }}"
                                            alt="Photo de profil"
                                            class="h-full w-full object-cover"
                                        >
                                    {% else %}
                                        {{ app.user.firstname ? app.user.firstname|first|upper : 'U' }}
                                    {% endif %}
                                </div>

                                <div class="hidden min-w-0 text-left md:block">
                                    <p class="text-sm font-semibold text-[#292524]">
                                        {{ is_granted('ROLE_ADMIN') ? 'Administrateur' : 'Gestionnaire' }}
                                    </p>

                                    <p class="max-w-[180px] truncate text-xs text-stone-500">
                                        {{ app.user.email }}
                                    </p>
                                </div>

                                <span class="text-xs text-stone-500 transition group-open:rotate-180">
                                    ▼
                                </span>

                            </summary>

                            {# Menu du profil responsive #}
                            <div class="absolute right-0 top-full z-[100] mt-3 w-64 max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-[#E5D9CA] bg-white py-2 shadow-xl">

                                <div class="border-b border-[#F0E8DE] px-4 py-3">
                                    <p class="truncate text-sm font-semibold text-[#292524]">
                                        {{ app.user.firstname }} {{ app.user.lastname }}
                                    </p>

                                    <p class="mt-1 break-all text-xs text-stone-500">
                                        {{ app.user.email }}
                                    </p>
                                </div>

                                <a
                                    href="/administration/profil/modifier"
                                    class="flex items-center gap-3 px-4 py-3 text-sm text-[#44403C] transition hover:bg-[#F5F0E8] hover:text-[#8C694A]"
                                >
                                    <span>✎</span>
                                    Modifier mes informations
                                </a>

                                <a
                                    href="/administration/profil/securite"
                                    class="flex items-center gap-3 px-4 py-3 text-sm text-[#44403C] transition hover:bg-[#F5F0E8] hover:text-[#8C694A]"
                                >
                                    <span>♧</span>
                                    Changer mon mot de passe
                                </a>

                            </div>

                        </details>
                    </div>

                </div>
            </header>

            {# CONTENU DE CHAQUE PAGE #}
            <main class="px-4 py-7 sm:px-7 lg:px-10 lg:py-9">
                {% block admin_content %}{% endblock %}
            </main>

            {# FOOTER #}
            <footer class="mx-4 flex flex-col gap-2 border-t border-[#E5D9CA] px-0 py-5 text-xs text-stone-500 sm:mx-7 sm:flex-row sm:items-center sm:justify-between lg:mx-10">
                <p>© {{ "now"|date("Y") }} ModeBoutique · Administration</p>
                <p class="font-serif italic text-[#B08D67]">La mode, c'est vous ♡</p>
            </footer>

        </div>
    </div>

    <script>
        document.body.dataset.notificationUrl = '{{ path('app_notifications_counts') }}';
    </script>

    <script src="{{ asset('js/notifications.js') }}" defer></script>
{% endblock %}
