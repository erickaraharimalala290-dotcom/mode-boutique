<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {# --- SEO --- #}
    <title>{% block title %}ModeBoutique — Vêtements, chaussures et accessoires{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}ModeBoutique, votre boutique en ligne élégante de vêtements, chaussures et accessoires pour femme, homme et enfant.{% endblock %}">
    <meta name="theme-color" content="#577C95">

    {# --- Favicon simplifié (SVG une seule ligne) --- #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%23577C95'/><text x='32' y='44' font-family='Georgia,serif' font-size='36' font-weight='700' fill='%23F0E4D2' text-anchor='middle'>M</text></svg>">

    {# --- Polices Google : Inter (texte) + Playfair Display (titres) --- #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

    {# --- Styles additionnels éventuels --- #}
    {% block stylesheets %}{% endblock %}

    {# --- AssetMapper : charge app.css (Tailwind) et app.js --- #}
    {% block importmap %}{{ importmap('app') }}{% endblock %}

    {# --- FrankenPHP hot-reload (dev uniquement) — conservé --- #}
    {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}

    {# --- Animations discrètes (désactivées si prefers-reduced-motion) --- #}
    <style>
        @media (prefers-reduced-motion: no-preference) {
            @keyframes fadeInUp {
                from { opacity: 0; transform: translateY(16px); }
                to   { opacity: 1; transform: translateY(0); }
            }
            .fade-in-up { animation: fadeInUp 0.7s ease-out both; }
            .fade-in-up-delay-1 { animation-delay: 0.1s; }
            .fade-in-up-delay-2 { animation-delay: 0.2s; }
            .fade-in-up-delay-3 { animation-delay: 0.3s; }
        }
        @media (prefers-reduced-motion: reduce) {
            .fade-in-up,
            .fade-in-up-delay-1,
            .fade-in-up-delay-2,
            .fade-in-up-delay-3 { animation: none; }
        }
    </style>
</head>
<body class="bg-white text-ink font-sans antialiased min-h-screen flex flex-col">

    {# --- Navbar globale (fichier existant, non modifié) --- #}
    {% include 'partials/_nav.html.twig' %}

    {# --- Contenu principal des pages --- #}
    <main class="flex-1">
        {% block body %}{% endblock %}
    </main>

    {% include 'partials/_footer.html.twig' %}

    {# --- Scripts additionnels éventuels --- #}
    {% block javascripts %}{% endblock %}
</body>
</html>